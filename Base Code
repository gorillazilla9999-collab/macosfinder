<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Pear Finder</title>

<style>
*{box-sizing:border-box}

:root{
    --text:#17171a;
    --muted:#777;
    --window:rgba(250,250,252,.94);
    --sidebar:rgba(235,235,240,.92);
    --toolbar:rgba(250,250,252,.94);
    --hover:rgba(0,0,0,.08);
    --border:rgba(0,0,0,.12);
    --blue:#087cff;
    --input:rgba(0,0,0,.07);
}

body.dark{
    --text:#f5f5f7;
    --muted:#aaa;
    --window:rgba(35,35,39,.96);
    --sidebar:rgba(28,28,31,.96);
    --toolbar:rgba(40,40,44,.96);
    --hover:rgba(255,255,255,.09);
    --border:rgba(255,255,255,.12);
    --input:rgba(255,255,255,.08);
}

html,body{
    width:100%;
    height:100%;
    margin:0;
    overflow:hidden;
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",
                 "Helvetica Neue",Arial,sans-serif;
    color:var(--text);
}

button,input,textarea{
    font:inherit;
}

button{
    color:inherit;
}

.hidden{
    display:none!important;
}

/* =========================
   BOOT
========================= */

#boot{
    position:fixed;
    inset:0;
    z-index:999999;
    background:#050505;
    color:white;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    transition:opacity .8s;
}

.pear{
    width:110px;
    height:125px;
    position:relative;
    margin-bottom:48px;
}

.pearBody{
    position:absolute;
    width:84px;
    height:92px;
    left:13px;
    top:25px;
    background:linear-gradient(145deg,#e2ff7b,#79c936);
    border-radius:55% 55% 48% 48%;
    transform:rotate(-5deg);
}

.pearTop{
    position:absolute;
    width:48px;
    height:58px;
    left:31px;
    top:9px;
    background:linear-gradient(145deg,#edff9d,#8ed64a);
    border-radius:55%;
}

.pearStem{
    position:absolute;
    z-index:3;
    width:10px;
    height:35px;
    left:57px;
    top:0;
    background:#80542b;
    border-radius:10px;
    transform:rotate(16deg);
}

.pearLeaf{
    position:absolute;
    z-index:4;
    width:36px;
    height:18px;
    left:65px;
    top:3px;
    background:#6ebd38;
    border-radius:100% 0 100% 0;
    transform:rotate(-25deg);
}

#bootStatus{
    color:#aaa;
    font-size:14px;
}

.spinner{
    width:18px;
    height:18px;
    border:2px solid #444;
    border-top-color:white;
    border-radius:50%;
    margin-top:23px;
    animation:spin 1s linear infinite;
}

@keyframes spin{
    to{transform:rotate(360deg)}
}

/* =========================
   DESKTOP
========================= */

#desktop{
    position:fixed;
    inset:0;
    background:
        radial-gradient(circle at 20% 20%,#426ca0 0,transparent 35%),
        radial-gradient(circle at 80% 70%,#713d91 0,transparent 40%),
        linear-gradient(135deg,#15264a,#321f59,#162c55);
}

#menubar{
    position:absolute;
    z-index:9000;
    top:0;
    left:0;
    right:0;
    height:30px;
    padding:0 12px;
    display:flex;
    align-items:center;
    background:rgba(20,20,25,.43);
    backdrop-filter:blur(20px);
    color:white;
    font-size:13px;
    user-select:none;
}

.apple{
    font-size:19px;
    margin-right:12px;
}

.menu{
    padding:5px 9px;
    border-radius:5px;
    cursor:pointer;
}

.menu:hover{
    background:rgba(255,255,255,.13);
}

#clock{
    margin-left:auto;
}

#desktopIcons{
    position:absolute;
    right:18px;
    top:45px;
    width:105px;
    display:flex;
    flex-direction:column;
    gap:13px;
}

.desktopIcon{
    width:100px;
    padding:6px;
    text-align:center;
    color:white;
    text-shadow:0 1px 4px #000;
    border-radius:8px;
    user-select:none;
}

.desktopIcon:hover{
    background:rgba(255,255,255,.14);
}

.desktopIcon .icon{
    font-size:43px;
    line-height:48px;
}

.desktopIcon .name{
    font-size:12px;
    overflow-wrap:anywhere;
}

/* =========================
   WINDOWS
========================= */

.window{
    position:absolute;
    min-width:520px;
    min-height:330px;
    background:var(--window);
    border:1px solid var(--border);
    border-radius:14px;
    overflow:hidden;
    box-shadow:0 25px 80px rgba(0,0,0,.35);
    backdrop-filter:blur(25px);
}

.titlebar{
    height:45px;
    display:flex;
    align-items:center;
    background:var(--toolbar);
    border-bottom:1px solid var(--border);
    user-select:none;
    cursor:default;
}

.traffic{
    width:80px;
    padding-left:13px;
    display:flex;
    gap:8px;
}

.traffic button{
    border:0;
    width:13px;
    height:13px;
    border-radius:50%;
    padding:0;
    cursor:pointer;
}

.red{background:#ff5f57}
.yellow{background:#febc2e}
.green{background:#28c840}

.windowTitle{
    flex:1;
    text-align:center;
    font-size:13px;
    font-weight:600;
}

.spacer{
    width:80px;
}

/* =========================
   FINDER
========================= */

.finder{
    left:7%;
    top:7%;
    width:86%;
    height:82%;
}

.finderBody{
    height:calc(100% - 45px);
    display:flex;
}

.sidebar{
    width:205px;
    flex-shrink:0;
    padding:10px;
    background:var(--sidebar);
    border-right:1px solid var(--border);
    overflow:auto;
}

.sideTitle{
    color:var(--muted);
    text-transform:uppercase;
    font-size:11px;
    font-weight:bold;
    padding:9px;
}

.sideItem{
    display:flex;
    align-items:center;
    gap:9px;
    padding:7px 10px;
    border-radius:7px;
    cursor:pointer;
    font-size:13px;
}

.sideItem:hover{
    background:var(--hover);
}

.sideItem.selected{
    background:var(--blue);
    color:white;
}

.usbDot{
    margin-left:auto;
    width:7px;
    height:7px;
    border-radius:50%;
    background:#35c759;
}

.main{
    flex:1;
    min-width:0;
    display:flex;
    flex-direction:column;
}

.toolbar{
    height:46px;
    display:flex;
    align-items:center;
    gap:7px;
    padding:7px 10px;
    background:var(--toolbar);
    border-bottom:1px solid var(--border);
}

.tool{
    border:0;
    background:transparent;
    border-radius:6px;
    padding:5px 9px;
    cursor:pointer;
}

.tool:hover{
    background:var(--hover);
}

.tool:disabled{
    opacity:.3;
}

.search{
    margin-left:auto;
    width:180px;
    border:0;
    outline:0;
    border-radius:7px;
    background:var(--input);
    padding:6px 10px;
    color:var(--text);
}

.content{
    flex:1;
    overflow:auto;
    padding:18px;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,100px);
    gap:18px;
    align-content:start;
}

.file{
    width:95px;
    padding:8px 5px;
    text-align:center;
    border-radius:8px;
    cursor:default;
    user-select:none;
}

.file:hover{
    background:var(--hover);
}

.file.selected{
    background:rgba(0,122,255,.2);
}

.fileIcon{
    font-size:52px;
    line-height:55px;
}

.fileName{
    font-size:12px;
    overflow-wrap:anywhere;
}

.empty{
    width:100%;
    text-align:center;
    color:var(--muted);
    padding-top:80px;
}

.pathbar{
    height:28px;
    display:flex;
    align-items:center;
    padding:0 12px;
    border-top:1px solid var(--border);
    color:var(--muted);
    font-size:11px;
}

/* =========================
   EDITOR
========================= */

.editor{
    left:18%;
    top:13%;
    width:64%;
    height:68%;
}

.editorArea{
    height:calc(100% - 45px);
    display:flex;
    flex-direction:column;
}

textarea{
    flex:1;
    width:100%;
    resize:none;
    border:0;
    outline:0;
    padding:20px;
    background:var(--window);
    color:var(--text);
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
    font-size:14px;
    line-height:1.55;
}

.editorStatus{
    height:28px;
    padding:5px 12px;
    font-size:11px;
    color:var(--muted);
    border-top:1px solid var(--border);
}

/* =========================
   DIALOG
========================= */

.dialog{
    position:fixed;
    z-index:50000;
    left:50%;
    top:50%;
    transform:translate(-50%,-50%);
    width:390px;
    padding:24px;
    background:var(--window);
    border:1px solid var(--border);
    border-radius:15px;
    box-shadow:0 25px 80px rgba(0,0,0,.4);
}

.dialog h2{
    margin:0 0 8px;
    font-size:18px;
}

.dialog p{
    margin:0 0 15px;
    color:var(--muted);
    font-size:13px;
}

.dialog input{
    width:100%;
    border:0;
    outline:0;
    padding:9px 10px;
    border-radius:7px;
    background:var(--input);
    color:var(--text);
}

.dialogButtons{
    display:flex;
    justify-content:flex-end;
    gap:8px;
    margin-top:18px;
}

.dialogButtons button{
    border:0;
    border-radius:7px;
    padding:7px 15px;
    cursor:pointer;
}

.cancel{
    background:var(--input);
}

.primary{
    background:var(--blue);
    color:white;
}

/* =========================
   CONTEXT MENU
========================= */

#contextMenu{
    position:fixed;
    z-index:70000;
    min-width:190px;
    padding:5px;
    background:var(--window);
    border:1px solid var(--border);
    border-radius:10px;
    box-shadow:0 15px 40px rgba(0,0,0,.3);
    backdrop-filter:blur(20px);
}

.contextItem{
    padding:7px 10px;
    border-radius:6px;
    font-size:13px;
    cursor:pointer;
}

.contextItem:hover{
    background:var(--blue);
    color:white;
}

.contextSep{
    height:1px;
    background:var(--border);
    margin:5px;
}

/* =========================
   TOAST
========================= */

#toast{
    position:fixed;
    z-index:80000;
    left:50%;
    bottom:35px;
    transform:translateX(-50%);
    padding:10px 16px;
    border-radius:10px;
    background:rgba(30,30,30,.88);
    color:white;
    font-size:13px;
    opacity:0;
    pointer-events:none;
    transition:.2s;
}

#toast.show{
    opacity:1;
}

/* =========================
   USB WINDOW
========================= */

.usbInfo{
    display:flex;
    align-items:center;
    gap:15px;
    margin-bottom:20px;
    padding:15px;
    background:var(--input);
    border-radius:12px;
}

.usbBig{
    font-size:45px;
}

.usbText b{
    display:block;
    margin-bottom:4px;
}

.usbText span{
    color:var(--muted);
    font-size:12px;
}
</style>
</head>

<body>

<!-- =====================================================
     BOOT SCREEN
===================================================== -->

<div id="boot">
    <div class="pear">
        <div class="pearStem"></div>
        <div class="pearLeaf"></div>
        <div class="pearTop"></div>
        <div class="pearBody"></div>
    </div>

    <div id="bootStatus">Starting Pear...</div>
    <div class="spinner"></div>
</div>

<!-- =====================================================
     DESKTOP
===================================================== -->

<div id="desktop" class="hidden">

    <div id="menubar">
        <div class="apple">🍐</div>

        <div class="menu" onclick="finderMenu()">Finder</div>
        <div class="menu" onclick="newFolder()">File</div>
        <div class="menu" onclick="viewMenu()">View</div>
        <div class="menu" onclick="usbMenu()">USB</div>

        <div id="clock"></div>
    </div>

    <div id="desktopIcons"></div>

    <!-- FINDER -->

    <div id="finder" class="window finder">

        <div class="titlebar" onmousedown="startDrag(event,'finder')">

            <div class="traffic">
                <button class="red" onclick="closeFinder()"></button>
                <button class="yellow" onclick="minimizeFinder()"></button>
                <button class="green" onclick="maximize('finder')"></button>
            </div>

            <div class="windowTitle" id="finderTitle">
                Desktop
            </div>

            <div class="spacer"></div>
        </div>

        <div class="finderBody">

            <aside class="sidebar">

                <div class="sideTitle">Favorites</div>

                <div class="sideItem" onclick="goTo('desktop')">
                    🖥️ Desktop
                </div>

                <div class="sideItem" onclick="goTo('documents')">
                    📄 Documents
                </div>

                <div class="sideItem" onclick="goTo('downloads')">
                    📥 Downloads
                </div>

                <div class="sideItem" onclick="goTo('applications')">
                    🧩 Applications
                </div>

                <div class="sideItem" onclick="goTo('trash')">
                    🗑️ Trash
                </div>

                <div class="sideTitle">Devices</div>

                <div id="usbSidebar"></div>

            </aside>

            <main class="main">

                <div class="toolbar">

                    <button class="tool" onclick="goBack()">←</button>
                    <button class="tool" onclick="goForward()">→</button>
                    <button class="tool" onclick="goUp()">↑</button>

                    <button class="tool" onclick="newFolder()">＋ Folder</button>
                    <button class="tool" onclick="newTextFile()">＋ File</button>

                    <input
                        id="search"
                        class="search"
                        placeholder="Search"
                        oninput="searchFiles(this.value)"
                    >

                </div>

                <div id="content" class="content"></div>

                <div class="pathbar" id="pathbar"></div>

            </main>

        </div>
    </div>

    <!-- EDITOR -->

    <div id="editor" class="window editor hidden">

        <div class="titlebar" onmousedown="startDrag(event,'editor')">

            <div class="traffic">
                <button class="red" onclick="closeEditor()"></button>
                <button class="yellow" onclick="hideWindow('editor')"></button>
                <button class="green" onclick="maximize('editor')"></button>
            </div>

            <div class="windowTitle" id="editorTitle">
                TextEdit
            </div>

            <div class="spacer"></div>

        </div>

        <div class="editorArea">

            <textarea id="editorText"
                oninput="editorChanged()"
                spellcheck="false"></textarea>

            <div class="editorStatus" id="editorStatus">
                Saved
            </div>

        </div>

    </div>

</div>

<!-- =====================================================
     DIALOG
===================================================== -->

<div id="dialog" class="dialog hidden">

    <h2 id="dialogTitle"></h2>
    <p id="dialogMessage"></p>

    <input id="dialogInput" autocomplete="off">

    <div class="dialogButtons">
        <button class="cancel" onclick="dialogCancel()">Cancel</button>
        <button class="primary" onclick="dialogOK()">OK</button>
    </div>

</div>

<!-- CONTEXT MENU -->

<div id="contextMenu" class="hidden"></div>

<!-- TOAST -->

<div id="toast"></div>


<script>
/* =========================================================
   VIRTUAL FILESYSTEM
========================================================= */

const KEY = "pearFinderFS_v2";
const USBKEY = "pearFinderUSB_v2";
const SETTINGSKEY = "pearFinderSettings_v2";

let fs;
let usbDrives;
let settings;

let currentFolder = "desktop";
let history = [];
let historyIndex = -1;

let selected = null;
let clipboard = null;

let dialogCallback = null;
let editorFile = null;
let editorTimer = null;

let dragData = null;

/* =========================================================
   HELPERS
========================================================= */

function $(id){
    return document.getElementById(id);
}

function uid(){
    return Math.random().toString(36).slice(2)+Date.now().toString(36);
}

function save(){
    localStorage.setItem(KEY,JSON.stringify(fs));
    localStorage.setItem(USBKEY,JSON.stringify(usbDrives));
    localStorage.setItem(SETTINGSKEY,JSON.stringify(settings));
}

function escapeHTML(str){
    return String(str)
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");
}

/* =========================================================
   INITIAL FILESYSTEM
========================================================= */

function createInitialFS(){

    const now=Date.now();

    return {
        nodes:{
            desktop:{
                id:"desktop",
                name:"Desktop",
                type:"folder",
                parent:null,
                children:["welcome"]
            },

            documents:{
                id:"documents",
                name:"Documents",
                type:"folder",
                parent:null,
                children:[]
            },

            downloads:{
                id:"downloads",
                name:"Downloads",
                type:"folder",
                parent:null,
                children:[]
            },

            applications:{
                id:"applications",
                name:"Applications",
                type:"folder",
                parent:null,
                children:[]
            },

            trash:{
                id:"trash",
                name:"Trash",
                type:"trash",
                parent:null,
                children:[]
            },

            welcome:{
                id:"welcome",
                name:"Welcome.txt",
                type:"text",
                parent:"desktop",
                content:
`Welcome to Pear Finder!

This is a completely fake computer running inside your browser.

Try:
• Double-click folders
• Double-click text files
• Right-click files
• Create new folders
• Copy and paste files
• Plug in a virtual USB
• Drag files onto folders
• Search your files

Nothing here can access your real computer files.
`,
                created:now,
                modified:now
            }
        }
    };
}

function createInitialUSB(){

    return {};
}

/* =========================================================
   LOAD
========================================================= */

function load(){

    try{
        fs=JSON.parse(localStorage.getItem(KEY)) || createInitialFS();
    }catch{
        fs=createInitialFS();
    }

    try{
        usbDrives=JSON.parse(localStorage.getItem(USBKEY)) || createInitialUSB();
    }catch{
        usbDrives=createInitialUSB();
    }

    try{
        settings=JSON.parse(localStorage.getItem(SETTINGSKEY)) || {
            dark:false
        };
    }catch{
        settings={dark:false};
    }

    if(settings.dark){
        document.body.classList.add("dark");
    }

    save();
}

/* =========================================================
   NODE FUNCTIONS
========================================================= */

function node(id){
    if(fs.nodes[id]) return fs.nodes[id];

    for(const usb of Object.values(usbDrives)){
        if(usb.nodes && usb.nodes[id]) return usb.nodes[id];
    }

    return null;
}

function getChildren(parentId){
    const p=node(parentId);
    if(!p || !p.children) return [];

    return p.children.map(id=>node(id)).filter(Boolean);
}

function uniqueName(parentId,name){

    const existing=getChildren(parentId).map(x=>x.name);

    if(!existing.includes(name)) return name;

    const dot=name.lastIndexOf(".");
    const base=dot>0 ? name.slice(0,dot) : name;
    const ext=dot>0 ? name.slice(dot) : "";

    let i=2;
    let candidate;

    do{
        candidate=base+" "+i+ext;
        i++;
    }while(existing.includes(candidate));

    return candidate;
}

function addNode(parentId,obj){

    obj.id=uid();
    obj.parent=parentId;

    if(!obj.created) obj.created=Date.now();
    if(!obj.modified) obj.modified=Date.now();

    const parent=node(parentId);

    if(!parent.children) parent.children=[];

    parent.children.push(obj.id);

    if(isUSBId(parentId)){
        const usb=getUSBFromNode(parentId);
        usb.nodes[obj.id]=obj;
    }else{
        fs.nodes[obj.id]=obj;
    }

    save();

    return obj.id;
}

function isUSBId(id){
    return Object.values(usbDrives).some(u=>u.root===id);
}

function getUSBFromNode(id){

    for(const usb of Object.values(usbDrives)){
        if(usb.nodes && usb.nodes[id]) return usb;

        if(usb.root===id) return usb;
    }

    return null;
}

function removeNode(id){

    const n=node(id);
    if(!n) return;

    const p=node(n.parent);

    if(p && p.children){
        p.children=p.children.filter(x=>x!==id);
    }

    if(fs.nodes[id]){
        delete fs.nodes[id];
    }else{
        for(const usb of Object.values(usbDrives)){
            if(usb.nodes[id]){
                delete usb.nodes[id];
                break;
            }
        }
    }

    save();
}

/* =========================================================
   NAVIGATION
========================================================= */

function goTo(id,push=true){

    if(!node(id)) return;

    currentFolder=id;
    selected=null;

    if(push){
        history=history.slice(0,historyIndex+1);
        history.push(id);
        historyIndex++;
    }

    render();
}

function goBack(){

    if(historyIndex>0){
        historyIndex--;
        currentFolder=history[historyIndex];
        selected=null;
        render();
    }
}

function goForward(){

    if(historyIndex<history.length-1){
        historyIndex++;
        currentFolder=history[historyIndex];
        selected=null;
        render();
    }
}

function goUp(){

    const n=node(currentFolder);

    if(n && n.parent){
        goTo(n.parent);
    }
}

/* =========================================================
   RENDER
========================================================= */

function iconFor(n){

    if(!n) return "📄";

    if(n.type==="folder") return "📁";
    if(n.type==="trash") return "🗑️";
    if(n.type==="text") return "📄";
    if(n.type==="image") return "🖼️";
    if(n.type==="app") return "🧩";
    if(n.type==="usb") return "💾";

    return "📄";
}

function render(){

    renderContent();
    renderDesktop();
    renderUSBs();
    updateTitle();
    updateClock();
}

function renderContent(){

    const content=$("content");

    if(!node(currentFolder)){
        currentFolder="desktop";
    }

    const n=node(currentFolder);

    if(!n){
        content.innerHTML="";
        return;
    }

    if(n.type==="trash"){
        renderTrash(content);
        return;
    }

    if(n.type==="usb"){
        renderUSBRoot(content,n);
        return;
    }

    const children=getChildren(currentFolder);

    content.innerHTML='<div class="grid"></div>';

    const grid=content.querySelector(".grid");

    if(!children.length){
        content.innerHTML='<div class="empty">This folder is empty</div>';
        return;
    }

    children.forEach(child=>{
        grid.appendChild(makeFileElement(child));
    });
}

function makeFileElement(n){

    const el=document.createElement("div");

    el.className="file"+(selected===n.id?" selected":"");
    el.draggable=true;

    el.innerHTML=`
        <div class="fileIcon">${iconFor(n)}</div>
        <div class="fileName">${escapeHTML(n.name)}</div>
    `;

    el.onclick=e=>{
        e.stopPropagation();
        selected=n.id;
        renderContent();
    };

    el.ondblclick=e=>{
        e.stopPropagation();
        openNode(n.id);
    };

    el.oncontextmenu=e=>{
        e.preventDefault();
        e.stopPropagation();
        selected=n.id;
        showContextMenu(e.clientX,e.clientY,n.id);
    };

    el.ondragstart=()=>{
        dragData=n.id;
    };

    el.ondragover=e=>{
        if(n.type==="folder" || n.type==="usb"){
            e.preventDefault();
        }
    };

    el.ondrop=e=>{
        e.preventDefault();

        if(!dragData) return;

        const dragged=node(dragData);

        if(
            dragged &&
            (n.type==="folder" || n.type==="usb") &&
            dragged.id!==n.id
        ){
            moveNode(dragged.id,n.id);
        }

        dragData=null;
    };

    return el;
}

function renderTrash(content){

    const trash=node("trash");
    const children=getChildren("trash");

    if(!children.length){
        content.innerHTML='<div class="empty">Trash is Empty</div>';
        return;
    }

    content.innerHTML='<div class="grid"></div>';

    const grid=content.querySelector(".grid");

    children.forEach(n=>{
        grid.appendChild(makeFileElement(n));
    });
}

function renderUSBRoot(content,n){

    const usb=getUSBFromNode(n.id);

    if(!usb){
        content.innerHTML='<div class="empty">USB unavailable</div>';
        return;
    }

    const children=getChildren(n.id);

    content.innerHTML=`
        <div class="usbInfo">
            <div class="usbBig">💾</div>
            <div class="usbText">
                <b>${escapeHTML(usb.name)}</b>
                <span>Virtual USB Drive • ${usb.capacity} GB</span>
            </div>
        </div>
        <div class="grid"></div>
    `;

    const grid=content.querySelector(".grid");

    if(!children.length){
        grid.innerHTML='<div class="empty">USB is empty</div>';
        return;
    }

    children.forEach(child=>{
        grid.appendChild(makeFileElement(child));
    });
}

function updateTitle(){

    const n=node(currentFolder);

    $("finderTitle").textContent=n ? n.name : "Finder";

    let path=[];

    let current=n;

    while(current){

        path.unshift(current.name);

        if(!current.parent) break;

        current=node(current.parent);
    }

    $("pathbar").textContent=path.join(" › ");
}

/* =========================================================
   DESKTOP
========================================================= */

function renderDesktop(){

    const box=$("desktopIcons");
    box.innerHTML="";

    const desktopChildren=getChildren("desktop");

    desktopChildren.forEach(n=>{

        const d=document.createElement("div");

        d.className="desktopIcon";

        d.innerHTML=`
            <div class="icon">${iconFor(n)}</div>
            <div class="name">${escapeHTML(n.name)}</div>
        `;

        d.ondblclick=()=>{
            openNode(n.id);
        };

        d.onclick=()=>{
            selected=n.id;
        };

        box.appendChild(d);
    });

    Object.values(usbDrives).forEach(usb=>{

        if(!usb.connected) return;

        const d=document.createElement("div");

        d.className="desktopIcon";

        d.innerHTML=`
            <div class="icon">💾</div>
            <div class="name">${escapeHTML(usb.name)}</div>
        `;

        d.ondblclick=()=>{
            goTo(usb.root);
        };

        d.oncontextmenu=e=>{
            e.preventDefault();
            showUSBContext(e.clientX,e.clientY,usb.id);
        };

