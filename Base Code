function ask(title,label,value,done){let shade=document.createElement('div');shade.className='shade';shade.innerHTML=`<div class="dialog"><div class="db"><h3>${esc(title)}</h3><p>${esc(label)}</p><input id="askv" value="${esc(value)}"></div><div class="actions"><button id="cancel">Cancel</button><button class="primary" id="ok">OK</button></div></div>`;document.getElementById('os').appendChild(shade);let inp=shade.querySelector('#askv');inp.focus();inp.select();let finish=()=>{let v=inp.value.trim();shade.remove();if(v)done(v)};shade.querySelector('#ok').onclick=finish;shade.querySelector('#cancel').onclick=()=>shade.remove();inp.onkeydown=e=>{if(e.key==='Enter')finish();if(e.key==='Escape')shade.remove()}}
function sortItems(a){let k=S.settings.sort;return a.sort((x,y)=>{let A=x[k],B=y[k];if(k==='size'){A=+A||0;B=+B||0}else{A=String(A).toLowerCase();B=String(B).toLowerCase()}let n=A<B?-1:A>B?1:0;return S.settings.asc?n:-n})}
