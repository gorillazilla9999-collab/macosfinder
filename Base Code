let dragWindow = null;
let dragOffsetX = 0;
let dragOffsetY = 0;

document.querySelectorAll(".titlebar").forEach(bar => {
    bar.addEventListener("mousedown",event => {
        if (event.target.closest(".traffic")) return;

        const id = bar.dataset.drag;
        const win = $(id);

        if (!win || win.classList.contains("maximized")) {
            return;
        }

        dragWindow = win;

