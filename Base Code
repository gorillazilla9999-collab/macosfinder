r,.sel{background:#4b82ff28}.ico{font-size:41px;line-height:48px}.fname{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.listhead,.row{display:grid;grid-template-columns:minmax(190px,2fr) 90px 90px 150px;gap:8px;padding:7px 9px;font-size:12px;align-items:center}.listhead{font-weight:700;opacity:.55;border-bottom:1px solid #0001}.row{border-radius:6px;cursor:pointer}.row:hover{background:#4b82ff20}.status{height:25px;padding:5px 10px;font-size:11px;opacity:.6;border-top:1px solid #0001}.viewer{height:100%;overflow:auto;padding:20px;white-space:pre-wrap;font:13px/1.6 ui-monospace,monospace}.info{height:100%;overflow:auto;padding:20px}.infogrid{display:grid;grid-template-columns:130px 1fr;gap:9px;font-size:13px}.infogrid b{opacity:.55}
