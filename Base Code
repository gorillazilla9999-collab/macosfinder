async function createFolderPrompt() {
    const name = await ask(
        "New Folder",
        "Enter a name for the new folder:",
        "Untitled Folder"
    );

    if (!name) return;

    const parent = getNode(state.current);

    if (!parent || parent.type !== "folder") {
        return;
    }

    const folder = createFolder(
        uniqueName(parent.id,name),
        parent.id
    );

    addNode(folder);

    toast("Folder created");

    render();
}

async function createFilePrompt(fileType = "txt") {
    const extensions = {
        txt: ".txt",
        md: ".md",
        html: ".html",
        js: ".js",
        json: ".json"
    };

    const defaults = {
        txt: "Untitled.txt",
        md: "Untitled.md",
        html: "Untitled.html",
        js: "Untitled.js",
        json: "Untitled.json"
    };

    const type =
        fileType ||
        await chooseFileType();

    if (!type) return;

    const name = await ask(
        "New File",
        `Enter a name for the new ${TYPE_INFO[type].label}:`,
        defaults[type]
    );

    if (!name) return;

    const parent = getNode(state.current);

    const file = createFile(
        uniqueName(parent.id,name),
        type,
        parent.id,
        defaultContent(type)
    );

    addNode(file);

    toast("File created");

    render();

    openEditor(file.id);
}

function defaultContent(type) {
    if (type === "md") return "# New Document\n\n";
    if (type === "html") {
        return "<!DOCTYPE html>\n<html>\n<head>\n    <title>New Page</title>\n</head>\n<body>\n    \n</body>\n</html>";
    }

    if (type === "js") {
        return '// New JavaScript file\n\nconsole.log("Hello!");';
    }

    if (type === "json") {
        return '{\n    "example": true\n}';
    }

    return "";
}

async function chooseFileType() {
    const type = prompt(
        "File type:\n\n1 = Text\n2 = Markdown\n3 = HTML\n4 = JavaScript\n5 = JSON",
        "1"
    );

    return ({
        "1":"txt",
        "2":"md",
        "3":"html",
        "4":"js",
        "5":"json"
    })[type] || null;
}

/* =========================================================
   RENAME
   ========================================================= */

async function renameNode(id) {
    const node = getNode(id);

    if (!node || id === "root" || id === "trash") {
        return;
    }

    const newName = await ask(
        "Rename",
        "Enter the new name:",
        node.name
    );

    if (!newName || newName === node.name) {
        return;
    }

    node.name = uniqueName(
        node.parent,
        newName
    );

    node.modified = now();

    saveFS();

    toast("File renamed");

    render();
}

/* =========================================================
   EDITOR
   ========================================================= */

function openEditor(id) {
    const node = getNode(id);

    if (
        !node ||
        node.type !== "file" ||
        !TEXT_TYPES.includes(node.fileType)
    ) {
        return;
    }

    state.editorId = id;
    state.editorOriginal = node.content || "";
    state.editorDirty = false;

    $("editorName").value = node.name;
    $("editorText").value = node.content || "";

    $("editorTitle").textContent =
        node.name;

    $("editorStatus").textContent =
        "Saved";

    openWindow("editorWindow");
}

function editorChanged() {
    state.editorDirty =
        $("editorText").value !==
        state.editorOriginal;

    $("editorStatus").textContent =
        state.editorDirty
            ? "Unsaved changes"
            : "Saved";
}

function saveEditor() {
    const node = getNode(state.editorId);

    if (!node) return;

    let name =
        $("editorName").value.trim();

    if (!name) {
        name = node.name;
    }

    node.name = uniqueName(
        node.parent,
        name
    );

    node.content =
        $("editorText").value;

    node.size =
        new Blob([node.content]).size;

    node.modified = now();

    state.editorOriginal =
        node.content;

    state.editorDirty = false;

    saveFS();

    $("editorStatus").textContent =
        "Saved";

    $("editorTitle").textContent =
        node.name;

    toast("Saved");

    render();
}

async function closeEditor() {
    if (state.editorDirty) {
        const answer = confirm(
            "You have unsaved changes. Close without saving?"
        );

        if (!answer) return;
    }

    $("editorWindow").classList.add("hidden");

    state.editorId = null;
    state.editorDirty = false;
}

/* =========================================================
   CONTEXT MENU
   ========================================================= */

function showContextMenu(x,y,id = null) {
    const menu = $("contextMenu");

    menu.innerHTML = "";

    const node = id ? getNode(id) : null;

    const add = (label,callback,disabled=false) => {
        const item =
            document.createElement("div");

        item.className =
            "context-item" +
            (disabled ? " disabled" : "");

        item.textContent = label;

        item.addEventListener("click",() => {
            hideContextMenu();

            if (!disabled) {
                callback();
            }
        });

        menu.appendChild(item);
    };

    if (node) {
        add("Open",() => openNode(id));

        add("Rename",() => renameNode(id),
            id === "root" || id === "trash");

        add("Duplicate",() => duplicateNode(id));

        menu.appendChild(separator());

        add("Copy",() => {
            state.selected.clear();
            state.selected.add(id);
            copySelection(false);
        });

        add("Cut",() => {
            state.selected.clear();
            state.selected.add(id);
            copySelection(true);
        });

        add("Paste",pasteClipboard,
            !state.clipboard);

        menu.appendChild(separator());

        if (node.parent === "trash") {
            add("Restore",() => restoreFromTrash(id));
            add("Delete Permanently",() => {
                if (confirm("Permanently delete this item?")) {
                    deleteNodePermanently(id);
                    toast("Permanently deleted");
                    render();
                }
            });
        } else {
            add("Move to Trash",() => moveToTrash(id),
                id === "trash");
        }

        add("Get Info",() => showInfo(id));

        menu.appendChild(separator());

        if (node.type === "folder") {
            add("New Folder",createFolderPrompt);
            add("New File",() => createFilePrompt("txt"));
        }

    } else {
        add("New Folder",createFolderPrompt);

        add("New File",() => createFilePrompt("txt"));

        menu.appendChild(separator());

        add("Paste",pasteClipboard,
            !state.clipboard);

        add("Select All",() => {
            selectAll();
        });

        menu.appendChild(separator());

        add("Get Info",() => {
            showInfo(state.current);
        });

        add("Change Wallpaper",changeWallpaper);
    }

    menu.classList.add("show");

    const rect =
        menu.getBoundingClientRect();

    menu.style.left =
        Math.min(x,window.innerWidth - rect.width - 8) + "px";

    menu.style.top =
        Math.min(y,window.innerHeight - rect.height - 8) + "px";
}

function separator() {
    const el = document.createElement("div");
    el.className = "context-separator";
    return el;
}

function hideContextMenu() {
    $("contextMenu").classList.remove("show");
}

