function gamePage(title,text){return `<div class="site"><div class="sitehero">${esc(title)}</div><p>${esc(text)}</p><div class="sitecard"><button id="fakeGameBtn" style="font-size:22px;padding:18px 28px">START GAME</button><div id="gameMsg" style="margin-top:14px">Score: 0</div></div></div>`}
function normalizeUrl(v){v=v.trim();if(!v)return 'pear://home';if(!/^[a-z]+:\/\//i.test(v)){return `pear://search?q=${encodeURIComponent(v)}`}return v.split('#')[0]}
function searchSite(q){q=q.toLowerCase().trim();let out=[];for(const [u,p] of Object.entries(sites)){if(u.includes(q)||p.title.toLowerCase().includes(q))out.push([u,p.title])}return out}
function browser(){let w=win('PearBrowser',980,650);let state={tabs:[{url:'pear://home',title:'New Tab',icon:'🌐',history:['pear://home'],pos:0}],active:0};function draw(){let t=state.tabs[state.active];w.querySelector('.body').innerHTML=`<div class="browser"><div class="b-tabs">${state.tabs.map((x,i)=>`<div class="btab ${i===state.active?'active':''}" data-tab="${i}">${x.icon} <span class="ttext">${esc(x.title)}</span><span data-close="${i}">×</span></div>`).join('')}<div class="btab" id="newtab" style="min-width:42px;width:42px;justify-content:center">＋</div></div><div class="bbar"><button id="bback">←</button><button id="bfwd">→</button><button id="breload">↻</button><button id="bhome">⌂</button><input id="baddr" class="addr" value="${esc(t.url)}"><button id="bgo">Go</button></div><div class="bpage" id="bpage"></div></div>`;let page=w.querySelector('#bpage');renderBrowserPage(page,t.url);w.querySelectorAll('[data-tab]').forEach(e=>e.onclick=()=>{state.active=+e.dataset.tab;draw()});w.querySelectorAll('[data-close]').forEach(e=>e.onclick=ev=>{ev.stopPropagation();let i=+e.dataset.close;if(state.tabs.length===1)return;state.tabs.splice(i,1);state.active=Math.max(0,Math.min(state.active,state.tabs.length-1));draw()});w.querySelector('#newtab').onclick=()=>{state.tabs.splice(state.active+1,0,{url:'pear://home',title:'New Tab',icon:'🌐',history:['pear://home'],pos:0});state.active++;draw()};w.querySelector('#bgo').onclick=()=>go(w,state,normalizeUrl(w.querySelector('#baddr').value));w.querySelector('#baddr').onkeydown=e=>{if(e.key==='Enter')go(w,state,normalizeUrl(e.target.value))};w.querySelector('#bback').onclick=()=>back(state,w);w.querySelector('#bfwd').onclick=()=>fwd(state,w);w.querySelector('#breload').onclick=()=>draw();w.querySelector('#bhome').onclick=()=>go(w,state,'pear://home')}
  function go(w,state,url){let t=state.tabs[state.active];if(t.history[t.pos]!==url){t.history=t.history.slice(0,t.pos+1);t.history.push(url);t.pos++}draw()}
