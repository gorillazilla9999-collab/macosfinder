    dragWindow = null;
});

/* =========================================================
   FILE EXPORT / IMPORT
   ========================================================= */

function exportFilesystem() {
    const blob = new Blob(
        [JSON.stringify(fs,null,2)],
        {type:"application/json"}
    );

    const url = URL.createObjectURL(blob);

    const a = document.createElement("a");

    a.href = url;
    a.download =
        "fake-finder-filesystem.json";

    a.click();

    setTimeout(
        () => URL.revokeObjectURL(url),
        1000
    );

    toast("Filesystem exported");
}

function importFilesystem(file) {
    const reader = new FileReader();

    reader.onload = () => {
        try {
            const imported =
                JSON.parse(reader.result);

            if (
                !imported ||
                !imported.nodes ||
                !imported.nodes.root
            ) {
                throw new Error("Invalid filesystem");
            }

            fs = imported;

            state.current = "desktop";
            state.selected.clear();
            state.history = ["desktop"];
            state.historyIndex = 0;

            saveFS();
            render();

            toast("Filesystem imported");

        } catch {
            toast("Invalid filesystem file");
        }
    };

    reader.readAsText(file);
}

