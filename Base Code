<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Fake macOS Finder</title>

<style>
/* =========================================================
   FAKE macOS FINDER
   Everything in this file is virtual and browser-only.
   ========================================================= */

:root {
    --bg: #f5f5f7;
    --window: rgba(255,255,255,.92);
    --window-solid: #fff;
    --sidebar: rgba(235,235,240,.82);
    --toolbar: rgba(250,250,252,.9);
    --text: #18181b;
    --muted: #73737a;
    --border: rgba(0,0,0,.10);
    --hover: rgba(0,0,0,.07);
    --selected: #007aff;
    --selected-text: white;
    --input: rgba(0,0,0,.06);
    --shadow: 0 20px 70px rgba(0,0,0,.25);
    --radius: 14px;
}

.dark {
    --bg: #161618;
    --window: rgba(38,38,42,.94);
    --window-solid: #262629;
    --sidebar: rgba(31,31,34,.92);
    --toolbar: rgba(42,42,45,.95);
    --text: #f5f5f7;
    --muted: #aaaab0;
    --border: rgba(255,255,255,.10);
    --hover: rgba(255,255,255,.08);
    --input: rgba(255,255,255,.08);
    --selected: #0a84ff;
    --selected-text: white;
    --shadow: 0 20px 70px rgba(0,0,0,.55);
}

* {
    box-sizing: border-box;
}

html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "SF Pro Display",
        "SF Pro Text",
        "Helvetica Neue",
        Arial,
        sans-serif;
    color: var(--text);
    background: #111;
}

button,
input,
textarea,
select {
    font: inherit;
}

button {
    color: inherit;
}

/* ---------- Desktop ---------- */

#desktop {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background:
        radial-gradient(circle at 20% 20%, rgba(90,150,255,.35), transparent 35%),
        radial-gradient(circle at 80% 75%, rgba(190,80,255,.3), transparent 35%),
        linear-gradient(135deg,#17264b,#5b2870 50%,#172b54);
    background-size: cover;
}

.desktop-overlay {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            120deg,
            rgba(255,255,255,.05),
            transparent 40%,
            rgba(0,0,0,.12)
        );
    pointer-events: none;
}

#desktop-icons {
    position: absolute;
    top: 25px;
    right: 20px;
    width: 110px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
}

.desktop-icon {
    width: 95px;
    padding: 7px 4px;
    border-radius: 8px;
    text-align: center;
    color: white;
    cursor: default;
    user-select: none;
    text-shadow: 0 1px 3px rgba(0,0,0,.8);
}

.desktop-icon:hover {
    background: rgba(255,255,255,.12);
}

.desktop-icon .icon {
    font-size: 44px;
    line-height: 48px;
    display: block;
}

.desktop-icon .label {
    font-size: 13px;
    margin-top: 4px;
    word-break: break-word;
}

/* ---------- Fake menu bar ---------- */

#menubar {
    position: fixed;
    z-index: 9000;
    top: 0;
    left: 0;
    right: 0;
    height: 28px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    color: white;
    background: rgba(20,20,25,.42);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    font-size: 13px;
    user-select: none;
}

#menubar .apple {
    font-size: 17px;
    margin-right: 16px;
}

.menu-item {
    padding: 4px 9px;
    border-radius: 5px;
    cursor: default;
}

.menu-item:hover {
    background: rgba(255,255,255,.14);
}

#clock {
    margin-left: auto;
}

/* ---------- Finder window ---------- */

.window {
    position: absolute;
    min-width: 500px;
    min-height: 320px;
    background: var(--window);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    overflow: hidden;
    animation: windowIn .18s ease-out;
}

.window.hidden {
    display: none;
}

.window.maximized {
    left: 8px !important;
    top: 35px !important;
    width: calc(100% - 16px) !important;
    height: calc(100% - 43px) !important;
    border-radius: 12px;
}

@keyframes windowIn {
    from {
        opacity: 0;
        transform: scale(.96);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.titlebar {
    height: 45px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    background: var(--toolbar);
    border-bottom: 1px solid var(--border);
    user-select: none;
    cursor: default;
}

.traffic {
    display: flex;
    gap: 8px;
    width: 70px;
}

.traffic button {
    width: 13px;
    height: 13px;
    border: 0;
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
}

.close {
    background: #ff5f57;
}

.minimize {
    background: #febc2e;
}

.maximize {
    background: #28c840;
}

.window-title {
    flex: 1;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
}

.window-title-spacer {
    width: 70px;
}

/* ---------- Finder ---------- */

.finder-body {
    display: flex;
    height: calc(100% - 45px);
}

.sidebar {
    width: 210px;
    flex-shrink: 0;
    padding: 12px 9px;
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    overflow-y: auto;
}

.sidebar-heading {
    padding: 10px 10px 5px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .5px;
}

.sidebar-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 10px;
    margin: 1px 0;
    border-radius: 7px;
    cursor: pointer;
    font-size: 13px;
}

.sidebar-item:hover {
    background: var(--hover);
}

.sidebar-item.active {
    background: var(--selected);
    color: var(--selected-text);
}

.sidebar-item .side-icon {
    width: 20px;
    text-align: center;
    font-size: 17px;
}

.main-area {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.toolbar {
    height: 51px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    background: var(--toolbar);
    border-bottom: 1px solid var(--border);
}

.tool-btn {
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
    cursor: pointer;
    font-size: 17px;
}

.tool-btn:hover {
    background: var(--hover);
}

.tool-btn:disabled {
    opacity: .35;
    cursor: default;
}

.path-title {
    flex: 1;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.search {
    width: 170px;
    height: 30px;
    border: 0;
    outline: 0;
    border-radius: 8px;
    padding: 0 10px 0 31px;
    color: var(--text);
    background: var(--input);
    position: relative;
}

.search-wrap {
    position: relative;
}

.search-icon {
    position: absolute;
    z-index: 2;
    left: 10px;
    top: 6px;
    color: var(--muted);
    pointer-events: none;
}

.content {
    position: relative;
    flex: 1;
    overflow: auto;
    padding: 15px;
}

.file-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill,minmax(105px,1fr));
    align-content: start;
    gap: 8px;
}

.file-list {
    display: flex;
    flex-direction: column;
}

.file-item {
    position: relative;
    border-radius: 9px;
    padding: 8px;
    cursor: default;
    user-select: none;
    outline: none;
}

.grid-item {
    min-height: 105px;
    text-align: center;
}

.file-item:hover {
    background: var(--hover);
}

.file-item.selected {
    background: var(--selected);
    color: var(--selected-text);
}

.file-item.dragging {
    opacity: .45;
}

.file-icon {
    font-size: 45px;
    line-height: 55px;
}

.grid-item .file-name {
    font-size: 12px;
    line-height: 17px;
    word-break: break-word;
    max-height: 36px;
    overflow: hidden;
}

.list-item {
    display: grid;
    grid-template-columns: 34px minmax(100px,1fr) 100px 100px 155px;
    align-items: center;
    min-height: 42px;
    padding: 4px 8px;
}

.list-item .file-icon {
    font-size: 25px;
    line-height: 30px;
}

.list-item .file-name {
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.list-meta {
    color: var(--muted);
    font-size: 12px;
}

.file-item.selected .list-meta {
    color: rgba(255,255,255,.8);
}

.list-header {
    display: grid;
    grid-template-columns: 34px minmax(100px,1fr) 100px 100px 155px;
    padding: 5px 8px 8px;
    color: var(--muted);
    font-size: 11px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 4px;
}

.empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    pointer-events: none;
}

.statusbar {
    height: 28px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    background: var(--toolbar);
}

.preview {
    width: 0;
    overflow: hidden;
    transition: width .2s ease;
    border-left: 1px solid var(--border);
    background: var(--window-solid);
}

.preview.open {
    width: 270px;
}

.preview-inner {
    padding: 20px;
    height: 100%;
    overflow: auto;
}

.preview-icon {
    text-align: center;
    font-size: 75px;
    margin-bottom: 12px;
}

.preview-name {
    font-weight: 600;
    text-align: center;
    word-break: break-word;
}

.preview-meta {
    color: var(--muted);
    font-size: 12px;
    margin-top: 15px;
}

.preview-content {
    margin-top: 16px;
    padding: 10px;
    border-radius: 8px;
    background: var(--input);
    white-space: pre-wrap;
    word-break: break-word;
    font-family: ui-monospace,SFMono-Regular,Menlo,monospace;
    font-size: 11px;
    max-height: 300px;
    overflow: auto;
}

/* ---------- Menus ---------- */

.context-menu {
    position: fixed;
    z-index: 10000;
    min-width: 210px;
    padding: 6px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--window-solid);
    box-shadow: 0 12px 35px rgba(0,0,0,.3);
    display: none;
}

.context-menu.show {
    display: block;
    animation: menuIn .1s ease-out;
}

@keyframes menuIn {
    from {
        opacity: 0;
        transform: scale(.96);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.context-item {
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 13px;
    cursor: pointer;
}

.context-item:hover {
    background: var(--selected);
    color: white;
}

.context-item.disabled {
    opacity: .35;
    pointer-events: none;
}

.context-separator {
    height: 1px;
    background: var(--border);
    margin: 5px 4px;
}

/* ---------- Dialogs ---------- */

.dialog {
    position: absolute;
    z-index: 11000;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    width: 400px;
    max-width: calc(100% - 30px);
    padding: 20px;
    background: var(--window-solid);
    border: 1px solid var(--border);
    border-radius: 15px;
    box-shadow: var(--shadow);
}

.dialog h2 {
    margin: 0 0 8px;
    font-size: 18px;
}

.dialog p {
    color: var(--muted);
    font-size: 13px;
}

.dialog input,
.dialog select,
.editor-name,
.editor-text {
    width: 100%;
    border: 1px solid var(--border);
    outline: 0;
    border-radius: 8px;
    padding: 9px;
    color: var(--text);
    background: var(--input);
}

.dialog-buttons {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 18px;
}

.btn {
    border: 0;
    border-radius: 8px;
    padding: 8px 14px;
    cursor: pointer;
}

.btn:hover {
    filter: brightness(.95);
}

.btn.secondary {
    background: var(--input);
}

.btn.primary {
    color: white;
    background: #007aff;
}

/* ---------- Editor ---------- */

.editor-window {
    width: 760px;
    height: 560px;
}

.editor-body {
    height: calc(100% - 45px);
    display: flex;
    flex-direction: column;
    padding: 12px;
    background: var(--window-solid);
}

.editor-name {
    margin-bottom: 10px;
    height: 35px;
}

.editor-text {
    flex: 1;
    resize: none;
    font-family: ui-monospace,SFMono-Regular,Menlo,monospace;
    font-size: 13px;
    line-height: 1.55;
}

.editor-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
}

.editor-status {
    margin-right: auto;
    color: var(--muted);
    font-size: 12px;
}

/* ---------- Info ---------- */

.info-window {
    width: 380px;
    min-height: 350px;
}

.info-body {
    padding: 22px;
}

.info-big-icon {
    font-size: 75px;
    text-align: center;
}

.info-name {
    text-align: center;
    font-size: 17px;
    font-weight: 600;
    margin: 8px;
    word-break: break-word;
}

.info-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 9px 0;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
}

.info-row span:last-child {
    color: var(--muted);
    text-align: right;
}

/* ---------- Settings ---------- */

.settings-window {
    width: 550px;
    min-height: 430px;
}

.settings-body {
    padding: 20px;
}

.settings-section {
    margin-bottom: 20px;
}

.settings-section h3 {
    font-size: 13px;
    margin-bottom: 8px;
}

.setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px;
    border-radius: 8px;
}

.setting-row:hover {
    background: var(--hover);
}

/* ---------- Toast ---------- */

#toasts {
    position: fixed;
    z-index: 20000;
    right: 20px;
    bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.toast {
    padding: 10px 15px;
    border-radius: 10px;
    background: rgba(30,30,35,.92);
    color: white;
    box-shadow: 0 7px 25px rgba(0,0,0,.25);
    font-size: 13px;
    animation: toastIn .2s ease-out;
}

@keyframes toastIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ---------- Search ---------- */

.search-results {
    color: var(--muted);
    font-size: 12px;
    margin-bottom: 10px;
}

/* ---------- Image preview ---------- */

.preview-image {
    display: block;
    max-width: 100%;
    max-height: 230px;
    margin: 15px auto;
    border-radius: 8px;
}

/* ---------- Responsive ---------- */

@media(max-width:800px) {
    .sidebar {
        width: 160px;
    }

    .preview.open {
        width: 220px;
    }

    .search {
        width: 110px;
    }

    .editor-window,
    .settings-window {
        width: calc(100% - 30px);
    }
}

@media(max-width:600px) {
    .sidebar {
        display: none;
    }

    .preview.open {
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        z-index: 10;
    }

    .list-item,
    .list-header {
        grid-template-columns: 34px 1fr 80px;
    }

    .list-item .list-meta:nth-last-child(-n+2),
    .list-header span:nth-last-child(-n+2) {
        display: none;
    }
}
</style>
</head>

<body>

<!-- =========================================================
     DESKTOP
     ========================================================= -->

<div id="desktop">
    <div class="desktop-overlay"></div>

    <div id="menubar">
        <span class="apple">●</span>
        <span class="menu-item" id="menuFinder">Finder</span>
        <span class="menu-item" id="menuFile">File</span>
        <span class="menu-item" id="menuView">View</span>
        <span class="menu-item" id="menuGo">Go</span>
        <span class="menu-item" id="menuWindow">Window</span>
        <span class="menu-item" id="menuHelp">Help</span>
        <span id="clock"></span>
    </div>

    <div id="desktop-icons"></div>

    <!-- Finder -->
    <div id="finderWindow" class="window" style="left:100px;top:70px;width:1000px;height:650px;z-index:100;">
        <div class="titlebar" data-drag="finderWindow">
            <div class="traffic">
                <button class="close" title="Close"></button>
                <button class="minimize" title="Minimize"></button>
                <button class="maximize" title="Maximize"></button>
            </div>
            <div class="window-title" id="finderTitle">Finder</div>
            <div class="window-title-spacer"></div>
        </div>

        <div class="finder-body">
            <aside class="sidebar" id="sidebar"></aside>

            <main class="main-area">
                <div class="toolbar">
                    <button class="tool-btn" id="backBtn" title="Back">‹</button>
                    <button class="tool-btn" id="forwardBtn" title="Forward">›</button>
                    <button class="tool-btn" id="parentBtn" title="Parent Folder">↑</button>

                    <div class="path-title" id="pathTitle">Desktop</div>

                    <div class="search-wrap">
                        <span class="search-icon">⌕</span>
                        <input id="searchBox" class="search" placeholder="Search">
                    </div>

                    <button class="tool-btn" id="newBtn" title="New">＋</button>
                    <button class="tool-btn" id="sortBtn" title="Sort">↕</button>
                    <button class="tool-btn" id="viewBtn" title="Toggle View">▦</button>
                    <button class="tool-btn" id="previewBtn" title="Preview">◨</button>
                    <button class="tool-btn" id="settingsBtn" title="Settings">⚙</button>
                </div>

                <div class="content" id="content"></div>

                <div class="statusbar" id="statusbar"></div>
            </main>

            <aside class="preview" id="preview">
                <div class="preview-inner" id="previewInner"></div>
            </aside>
        </div>
    </div>

    <!-- Context menu -->
    <div class="context-menu" id="contextMenu"></div>

    <!-- Dialog -->
    <div class="dialog hidden" id="dialog">
        <h2 id="dialogTitle"></h2>
        <p id="dialogMessage"></p>
        <input id="dialogInput">
        <div class="dialog-buttons">
            <button class="btn secondary" id="dialogCancel">Cancel</button>
            <button class="btn primary" id="dialogOK">OK</button>
        </div>
    </div>

    <!-- Editor -->
    <div id="editorWindow" class="window editor-window hidden" style="left:220px;top:100px;z-index:500;">
        <div class="titlebar" data-drag="editorWindow">
            <div class="traffic">
                <button class="close" id="editorClose"></button>
                <button class="minimize" id="editorMin"></button>
                <button class="maximize" id="editorMax"></button>
            </div>
            <div class="window-title" id="editorTitle">Text Editor</div>
            <div class="window-title-spacer"></div>
        </div>

        <div class="editor-body">
            <input id="editorName" class="editor-name">
            <textarea id="editorText" class="editor-text" spellcheck="false"></textarea>

            <div class="editor-actions">
                <span class="editor-status" id="editorStatus">Saved</span>
                <button class="btn secondary" id="editorCancel">Cancel</button>
                <button class="btn primary" id="editorSave">Save</button>
            </div>
        </div>
    </div>

    <!-- Info -->
    <div id="infoWindow" class="window info-window hidden" style="left:400px;top:150px;z-index:600;">
        <div class="titlebar" data-drag="infoWindow">
            <div class="traffic">
                <button class="close" id="infoClose"></button>
                <button class="minimize"></button>
                <button class="maximize" id="infoMax"></button>
            </div>
            <div class="window-title">Get Info</div>
            <div class="window-title-spacer"></div>
        </div>
        <div class="info-body" id="infoBody"></div>
    </div>

    <!-- Settings -->
    <div id="settingsWindow" class="window settings-window hidden" style="left:300px;top:120px;z-index:700;">
        <div class="titlebar" data-drag="settingsWindow">
            <div class="traffic">
                <button class="close" id="settingsClose"></button>
                <button class="minimize"></button>
                <button class="maximize"></button>
            </div>
            <div class="window-title">Finder Settings</div>
            <div class="window-title-spacer"></div>
        </div>

        <div class="settings-body">
            <div class="settings-section">
                <h3>Appearance</h3>

                <div class="setting-row">
                    <span>Dark Mode</span>
                    <input type="checkbox" id="darkToggle">
                </div>

                <div class="setting-row">
                    <span>Show Preview Panel</span>
                    <input type="checkbox" id="previewToggle">
                </div>
            </div>

            <div class="settings-section">
                <h3>Virtual Filesystem</h3>

                <div class="setting-row">
                    <span>Export filesystem</span>
                    <button class="btn secondary" id="exportBtn">Export JSON</button>
                </div>

                <div class="setting-row">
                    <span>Import filesystem</span>
                    <button class="btn secondary" id="importBtn">Import JSON</button>
                </div>

                <div class="setting-row">
                    <span>Reset virtual filesystem</span>
                    <button class="btn secondary" id="resetBtn">Reset</button>
                </div>
            </div>

            <div class="settings-section">
                <h3>About</h3>
                <p>
                    Fake macOS Finder<br>
                    A completely simulated filesystem running inside this webpage.
                </p>
            </div>
        </div>
    </div>

    <input type="file" id="importFile" accept=".json" hidden>

    <div id="toasts"></div>
</div>

<script>
"use strict";

/* =========================================================
   VIRTUAL FILESYSTEM
   ========================================================= */

const STORAGE_KEY = "fakeMacFinderFilesystem_v1";
const SETTINGS_KEY = "fakeMacFinderSettings_v1";

let fs = null;

const state = {
    current: "root",
    selected: new Set(),
    clipboard: null,
    history: ["root"],
    historyIndex: 0,
    view: "icons",
    sort: "name",
    sortDirection: 1,
    previewOpen: false,
    search: "",
    dragging: null,
    editorId: null,
    editorOriginal: "",
    editorDirty: false,
    z: 100
};

const $ = id => document.getElementById(id);

/* ---------- IDs ---------- */

function uid() {
    return "id_" +
        Date.now().toString(36) +
        "_" +
        Math.random().toString(36).slice(2,9);
}

/* ---------- Date helpers ---------- */

function now() {
    return new Date().toISOString();
}

function formatDate(value) {
    return new Date(value).toLocaleString([], {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit"
    });
}

function formatSize(bytes) {
    if (!bytes) return "0 bytes";
    if (bytes < 1024) return bytes + " bytes";
    if (bytes < 1024 * 1024) {
        return (bytes / 1024).toFixed(1) + " KB";
    }
    if (bytes < 1024 * 1024 * 1024) {
        return (bytes / (1024 * 1024)).toFixed(1) + " MB";
    }
    return (bytes / (1024 * 1024 * 1024)).toFixed(1) + " GB";
}

/* ---------- File types ---------- */

const TYPE_INFO = {
    folder: {
        icon: "📁",
        label: "Folder"
    },
    txt: {
        icon: "📄",
        label: "Text Document"
    },
    md: {
        icon: "📝",
        label: "Markdown Document"
    },
    html: {
        icon: "🌐",
        label: "HTML Document"
    },
    js: {
        icon: "🟨",
        label: "JavaScript File"
    },
    json: {
        icon: "🔶",
        label: "JSON File"
    },
    image: {
        icon: "🖼️",
        label: "Image"
    },
    unknown: {
        icon: "📄",
        label: "File"
    },
    trash: {
        icon: "🗑️",
        label: "Trash"
    }
};

const TEXT_TYPES = ["txt","md","html","js","json"];

function getType(node) {
    if (!node) return "unknown";
    if (node.type === "folder") return "folder";
    return node.fileType || "unknown";
}

/* ---------- Nodes ---------- */

function createFolder(name, parent) {
    const t = now();

    return {
        id: uid(),
        name,
        type: "folder",
        parent,
        children: [],
        created: t,
        modified: t
    };
}

function createFile(name, fileType, parent, content = "") {
    const t = now();

    return {
        id: uid(),
        name,
        type: "file",
        fileType,
        parent,
        content,
        size: new Blob([content]).size,
        created: t,
        modified: t
    };
}

function createFilesystem() {
    const root = createFolder("Macintosh HD", null);
    root.id = "root";

    const desktop = createFolder("Desktop", "root");
    desktop.id = "desktop";

    const documents = createFolder("Documents", "root");
    documents.id = "documents";

    const downloads = createFolder("Downloads", "root");
    downloads.id = "downloads";

    const pictures = createFolder("Pictures", "root");
    pictures.id = "pictures";

    const applications = createFolder("Applications", "root");
    applications.id = "applications";

    const trash = createFolder("Trash", "root");
    trash.id = "trash";
    trash.isTrash = true;

    root.children = [
        desktop.id,
        documents.id,
        downloads.id,
        pictures.id,
        applications.id,
        trash.id
    ];

    const welcome = createFile(
        "Welcome.txt",
        "txt",
        desktop.id,
        "Welcome to Fake Finder!\n\nThis is a completely virtual filesystem.\nNothing here can access your real computer files.\n\nTry creating folders, files, moving things around,\nand opening the built-in text editor."
    );

    const notes = createFile(
        "Notes.md",
        "md",
        documents.id,
        "# My Notes\n\nThis is a Markdown document inside Fake Finder.\n\n- Create files\n- Move files\n- Rename files\n- Search files\n"
    );

    const script = createFile(
        "hello.js",
        "js",
        documents.id,
        'console.log("Hello from Fake Finder!");\n\nfunction greet(name) {\n    return `Hello, ${name}!`;\n}'
    );

    const data = createFile(
        "example.json",
        "json",
        downloads.id,
        '{\n    "name": "Fake Finder",\n    "version": 1,\n    "virtual": true\n}'
    );

    const html = createFile(
        "index.html",
        "html",
        documents.id,
        "<!DOCTYPE html>\n<html>\n<head>\n    <title>Fake Page</title>\n</head>\n<body>\n    <h1>Hello!</h1>\n</body>\n</html>"
    );

    return {
        version: 1,
        root: "root",
        nodes: {
            root,
            desktop,
            documents,
            downloads,
            pictures,
            applications,
            trash,
            [welcome.id]: welcome,
            [notes.id]: notes,
            [script.id]: script,
            [data.id]: data,
            [html.id]: html
        }
    };
}

/* ---------- Persistence ---------- */

function saveFS() {
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(fs));
    } catch (error) {
        console.error("Could not save virtual filesystem:", error);
        toast("Could not save filesystem");
    }
}

function loadFS() {
    try {
        const raw = localStorage.getItem(STORAGE_KEY);

        if (!raw) {
            fs = createFilesystem();
            saveFS();
            return;
        }

        const parsed = JSON.parse(raw);

        if (
            !parsed ||
            !parsed.nodes ||
            !parsed.nodes.root
        ) {
            throw new Error("Invalid filesystem");
        }

        fs = parsed;

    } catch (error) {
        console.warn("Filesystem was corrupted. Creating a new one.", error);

        fs = createFilesystem();
        saveFS();

        toast("Filesystem was repaired");
    }
}

function saveSettings() {
    localStorage.setItem(
        SETTINGS_KEY,
        JSON.stringify({
            dark: document.body.classList.contains("dark"),
            view: state.view,
            preview: state.previewOpen,
            sort: state.sort,
            sortDirection: state.sortDirection
        })
    );
}

function loadSettings() {
    try {
        const raw = localStorage.getItem(SETTINGS_KEY);
        if (!raw) return;

        const s = JSON.parse(raw);

        if (s.dark) {
            document.body.classList.add("dark");
            $("darkToggle").checked = true;
        }

        if (s.view === "list" || s.view === "icons") {
            state.view = s.view;
        }

        if (typeof s.preview === "boolean") {
            state.previewOpen = s.preview;
        }

        if (s.sort) {
            state.sort = s.sort;
        }

        if (s.sortDirection) {
            state.sortDirection = s.sortDirection;
        }

    } catch {
        console.warn("Could not load settings");
    }
}

/* =========================================================
   NODE OPERATIONS
   ========================================================= */

function getNode(id) {
    return fs.nodes[id] || null;
}

function getParent(node) {
    return node && node.parent
        ? getNode(node.parent)
        : null;
}

function getChildren(folderId) {
    const folder = getNode(folderId);

    if (!folder || folder.type !== "folder") {
        return [];
    }

    return folder.children
        .map(id => getNode(id))
        .filter(Boolean);
}

function isDescendant(id, possibleParent) {
    let node = getNode(id);

    while (node && node.parent) {
        if (node.parent === possibleParent) {
            return true;
        }

        node = getNode(node.parent);
    }

    return false;
}

function uniqueName(parentId, original) {
    const siblings = getChildren(parentId);
    const names = new Set(
        siblings.map(n => n.name.toLowerCase())
    );

    if (!names.has(original.toLowerCase())) {
        return original;
    }

    const dot = original.lastIndexOf(".");
    const ext = dot > 0 ? original.slice(dot) : "";
    const base = dot > 0 ? original.slice(0,dot) : original;

    let i = 2;

    while (
        names.has(
            (base + " " + i + ext).toLowerCase()
        )
    ) {
        i++;
    }

    return base + " " + i + ext;
}

function addNode(node) {
    fs.nodes[node.id] = node;

    const parent = getNode(node.parent);

    if (parent && !parent.children.includes(node.id)) {
        parent.children.push(node.id);
        parent.modified = now();
    }

    saveFS();
}

function removeNodeFromParent(id) {
    const node = getNode(id);
    if (!node) return;

    const parent = getParent(node);

    if (parent) {
        parent.children = parent.children.filter(x => x !== id);
        parent.modified = now();
    }
}

function deleteNodePermanently(id) {
    const node = getNode(id);
    if (!node) return;

    if (node.type === "folder") {
        [...node.children].forEach(deleteNodePermanently);
    }

    removeNodeFromParent(id);
    delete fs.nodes[id];

    saveFS();
}

function moveNode(id, destinationId) {
    const node = getNode(id);
    const destination = getNode(destinationId);

    if (!node || !destination) return false;

    if (destination.type !== "folder") {
        return false;
    }

    if (id === destinationId) {
        return false;
    }

    if (node.type === "folder" && isDescendant(destinationId,id)) {
        toast("Cannot move a folder into itself");
        return false;
    }

    if (node.parent === destinationId) {
        return true;
    }

    const oldParent = getParent(node);

    if (oldParent) {
        oldParent.children =
            oldParent.children.filter(x => x !== id);
        oldParent.modified = now();
    }

    node.parent = destinationId;
    node.name = uniqueName(destinationId,node.name);
    node.modified = now();

    destination.children.push(id);
    destination.modified = now();

    saveFS();

    return true;
}

/* =========================================================
   TRASH
   ========================================================= */

function moveToTrash(id) {
    const node = getNode(id);

    if (!node || node.id === "trash") {
        return;
    }

    if (node.parent === "trash") {
        return;
    }

    node.originalParent = node.parent;

    if (moveNode(id,"trash")) {
        toast("Moved to Trash");
        state.selected.clear();
        render();
    }
}

function restoreFromTrash(id) {
    const node = getNode(id);

    if (!node || node.parent !== "trash") return;

    const destination =
        getNode(node.originalParent) || getNode("desktop");

    moveNode(id,destination.id);

    delete node.originalParent;

    saveFS();

    toast("Restored");
    render();
}

function emptyTrash() {
    const trash = getNode("trash");

    if (!trash.children.length) {
        toast("Trash is already empty");
        return;
    }

    if (!confirm("Permanently delete everything in Trash?")) {
        return;
    }

    [...trash.children].forEach(deleteNodePermanently);

    trash.children = [];

    saveFS();

    state.selected.clear();

    toast("Trash emptied");
    render();
}

/* =========================================================
   CLIPBOARD
   ========================================================= */

function copySelection(cut = false) {
    if (!state.selected.size) return;

    state.clipboard = {
        ids: [...state.selected],
        cut
    };

    toast(cut ? "Cut" : "Copied");
}

function cloneNode(id,parentId) {
    const source = getNode(id);
    if (!source) return null;

    let copy;

    if (source.type === "folder") {
        copy = createFolder(
            uniqueName(parentId,source.name),
            parentId
        );

        addNode(copy);

        for (const child of source.children) {
            cloneNode(child.id,copy.id);
        }

    } else {
        copy = createFile(
            uniqueName(parentId,source.name),
            source.fileType,
            parentId,
            source.content || ""
        );

        copy.size = source.size || 0;

        addNode(copy);
    }

    return copy;
}

function pasteClipboard() {
    if (!state.clipboard || !state.clipboard.ids.length) {
        toast("Nothing to paste");
        return;
    }

    const destination = getNode(state.current);

    if (!destination || destination.type !== "folder") {
        return;
    }

    const ids = [...state.clipboard.ids];

    if (state.clipboard.cut) {
        ids.forEach(id => {
            const node = getNode(id);

            if (node && node.id !== "trash") {
                moveNode(id,destination.id);
            }
        });

        toast("Pasted");
        state.clipboard = null;

    } else {
        ids.forEach(id => {
            cloneNode(id,destination.id);
        });

        toast("Pasted copy");
    }

    saveFS();
    render();
}

function duplicateNode(id) {
    const node = getNode(id);

    if (!node || node.id === "trash") return;

    const copy = cloneNode(
        id,
        node.parent
    );

    if (copy) {
        toast("Duplicated");
        saveFS();
        render();
    }
}

/* =========================================================
   NAVIGATION
   ========================================================= */

function navigate(id, addHistory = true) {
    const node = getNode(id);

    if (!node || node.type !== "folder") {
        return;
    }

    state.current = id;
    state.selected.clear();
    state.search = "";
    $("searchBox").value = "";

    if (addHistory) {
        state.history =
            state.history.slice(0,state.historyIndex + 1);

        state.history.push(id);
        state.historyIndex++;
    }

    render();
}

function goBack() {
    if (state.historyIndex <= 0) return;

    state.historyIndex--;
    state.current = state.history[state.historyIndex];

    state.selected.clear();

    render();
}

function goForward() {
    if (
        state.historyIndex >=
        state.history.length - 1
    ) return;

    state.historyIndex++;
    state.current = state.history[state.historyIndex];

    state.selected.clear();

    render();
}

function goParent() {
    const current = getNode(state.current);

    if (current && current.parent) {
        navigate(current.parent);
    }
}

/* =========================================================
   SEARCH
   ========================================================= */

function searchFilesystem(query) {
    query = query.trim().toLowerCase();

    if (!query) return [];

    return Object.values(fs.nodes)
        .filter(node => node.id !== "root")
        .filter(node => {
            const nameMatch =
                node.name.toLowerCase().includes(query);

            const contentMatch =
                node.type === "file" &&
                TEXT_TYPES.includes(node.fileType) &&
                (node.content || "")
                    .toLowerCase()
                    .includes(query);

            return nameMatch || contentMatch;
        });
}

/* =========================================================
   SORTING
   ========================================================= */

function sortedNodes(nodes) {
    const copy = [...nodes];

    copy.sort((a,b) => {
        let result = 0;

        if (state.sort === "name") {
            result = a.name.localeCompare(
                b.name,
                undefined,
                {numeric:true,sensitivity:"base"}
            );
        }

        if (state.sort === "type") {
            result = getType(a).localeCompare(getType(b));
        }

        if (state.sort === "size") {
            result =
                (a.size || 0) -
                (b.size || 0);
        }

        if (state.sort === "date") {
            result =
                new Date(a.modified) -
                new Date(b.modified);
        }

        return result * state.sortDirection;
    });

    return copy;
}

/* =========================================================
   RENDERING
   ========================================================= */

function render() {
    renderSidebar();
    renderContent();
    renderToolbar();
    renderStatus();
    renderPreview();
    renderDesktop();

    $("backBtn").disabled =
        state.historyIndex <= 0;

    $("forwardBtn").disabled =
        state.historyIndex >=
        state.history.length - 1;

    $("parentBtn").disabled =
        !getNode(state.current)?.parent;

    saveSettings();
}

function renderToolbar() {
    const current = getNode(state.current);

    $("pathTitle").textContent =
        state.search
            ? "Search"
            : current?.name || "Finder";

    $("finderTitle").textContent =
        state.search
            ? "Search"
            : current?.name || "Finder";
}

function renderSidebar() {
    const sidebar = $("sidebar");

    const locations = [
        ["desktop","🖥️","Desktop"],
        ["documents","📁","Documents"],
        ["downloads","⬇️","Downloads"],
        ["pictures","🖼️","Pictures"],
        ["applications","🧩","Applications"],
        ["trash","🗑️","Trash"]
    ];

    sidebar.innerHTML = `
        <div class="sidebar-heading">Favorites</div>
        ${locations.map(([id,icon,name]) => {
            const active =
                state.current === id &&
                !state.search;

            const trash =
                id === "trash"
                    ? ` <span style="margin-left:auto">${getChildren("trash").length || ""}</span>`
                    : "";

            return `
                <div class="sidebar-item ${active ? "active":""}"
                     data-side="${id}">
                    <span class="side-icon">${icon}</span>
                    <span>${name}</span>
                    ${trash}
                </div>
            `;
        }).join("")}

        <div class="sidebar-heading">Locations</div>

        <div class="sidebar-item ${state.current === "root" ? "active":""}"
             data-side="root">
            <span class="side-icon">💽</span>
            <span>Macintosh HD</span>
        </div>
    `;

    sidebar.querySelectorAll("[data-side]").forEach(item => {
        item.addEventListener("click",() => {
            navigate(item.dataset.side);
        });
    });
}

function renderContent() {
    const content = $("content");

    let nodes;

    if (state.search) {
        nodes = searchFilesystem(state.search);

        content.innerHTML = `
            <div class="search-results">
                ${nodes.length}
                result${nodes.length === 1 ? "" : "s"}
                for "${escapeHTML(state.search)}"
            </div>
        `;

        const grid = document.createElement("div");

        grid.className =
            state.view === "icons"
                ? "file-grid"
                : "file-list";

        content.appendChild(grid);

        renderNodes(grid,nodes,true);

        return;
    }

    nodes = sortedNodes(
        getChildren(state.current)
            .filter(n => !n.isTrash)
    );

    content.innerHTML = "";

    if (!nodes.length) {
        content.innerHTML = `
            <div class="empty">
                This folder is empty
            </div>
        `;

        return;
    }

    if (state.view === "list") {
        const header = document.createElement("div");

        header.className = "list-header";

        header.innerHTML = `
            <span></span>
            <span>Name</span>
            <span>Kind</span>
            <span>Size</span>
            <span>Modified</span>
        `;

        content.appendChild(header);
    }

    const grid = document.createElement("div");

    grid.className =
        state.view === "icons"
            ? "file-grid"
            : "file-list";

    content.appendChild(grid);

    renderNodes(grid,nodes,false);
}

function renderNodes(container,nodes,searchResult) {
    nodes.forEach(node => {
        const item = document.createElement("div");

        item.className =
            "file-item " +
            (state.view === "icons"
                ? "grid-item"
                : "list-item");

        item.dataset.id = node.id;
        item.draggable = true;

        if (state.selected.has(node.id)) {
            item.classList.add("selected");
        }

        const info =
            TYPE_INFO[getType(node)] ||
            TYPE_INFO.unknown;

        item.innerHTML =
            state.view === "icons"
                ? `
                    <div class="file-icon">${info.icon}</div>
                    <div class="file-name">
                        ${escapeHTML(node.name)}
                    </div>
                `
                : `
                    <div class="file-icon">${info.icon}</div>
                    <div class="file-name">
                        ${escapeHTML(node.name)}
                    </div>
                    <div class="list-meta">
                        ${info.label}
                    </div>
                    <div class="list-meta">
                        ${node.type === "file"
                            ? formatSize(node.size || 0)
                            : "—"}
                    </div>
                    <div class="list-meta">
                        ${formatDate(node.modified)}
                    </div>
                `;

        item.addEventListener("click", event => {
            selectItem(node.id,event);
        });

        item.addEventListener("dblclick",() => {
            openNode(node.id);
        });

        item.addEventListener("contextmenu",event => {
            event.preventDefault();

            if (!state.selected.has(node.id)) {
                state.selected.clear();
                state.selected.add(node.id);
                render();
            }

            showContextMenu(
                event.clientX,
                event.clientY,
                node.id
            );
        });

        item.addEventListener("dragstart",event => {
            state.dragging = node.id;
            item.classList.add("dragging");

            event.dataTransfer.effectAllowed =
                "copyMove";

            event.dataTransfer.setData(
                "text/plain",
                node.id
            );
        });

        item.addEventListener("dragend",() => {
            state.dragging = null;
            item.classList.remove("dragging");
        });

        item.addEventListener("dragover",event => {
            if (node.type === "folder") {
                event.preventDefault();
                event.dataTransfer.dropEffect = "move";
            }
        });

        item.addEventListener("drop",event => {
            event.preventDefault();

            const id =
                event.dataTransfer.getData("text/plain");

            if (
                id &&
                node.type === "folder" &&
                id !== node.id
            ) {
                if (moveNode(id,node.id)) {
                    toast("Moved");
                    state.selected.clear();
                    state.selected.add(id);
                    render();
                }
            }
        });

        container.appendChild(item);
    });
}

function selectItem(id,event) {
    if (event.metaKey || event.ctrlKey) {
        if (state.selected.has(id)) {
            state.selected.delete(id);
        } else {
            state.selected.add(id);
        }
    } else if (event.shiftKey && state.selected.size) {
        state.selected.add(id);
    } else {
        state.selected.clear();
        state.selected.add(id);
    }

    renderPreview();
    renderContent();
    renderStatus();
}

function openNode(id) {
    const node = getNode(id);

    if (!node) return;

    if (node.type === "folder") {
        navigate(id);
        return;
    }

    if (
        node.type === "file" &&
        TEXT_TYPES.includes(node.fileType)
    ) {
        openEditor(id);
        return;
    }

    if (
        node.type === "file" &&
        node.fileType === "image"
    ) {
        showInfo(id);
        return;
    }

    showInfo(id);
}

function renderStatus() {
    const current = getNode(state.current);

    const count =
        state.search
            ? searchFilesystem(state.search).length
            : getChildren(state.current).length;

    const selectedSize = [...state.selected]
        .map(id => getNode(id))
        .filter(Boolean)
        .reduce((sum,n) => sum + (n.size || 0),0);

    $("statusbar").textContent =
        `${count} item${count === 1 ? "" : "s"}` +
        (state.selected.size
            ? ` • ${state.selected.size} selected • ${formatSize(selectedSize)}`
            : "");
}

function renderPreview() {
    const panel = $("preview");

    panel.classList.toggle(
        "open",
        state.previewOpen
    );

    const inner = $("previewInner");

    if (!state.previewOpen) {
        inner.innerHTML = "";
        return;
    }

    if (state.selected.size !== 1) {
        inner.innerHTML = `
            <div style="color:var(--muted);text-align:center;margin-top:80px">
                Select one item to preview it.
            </div>
        `;
        return;
    }

    const id = [...state.selected][0];
    const node = getNode(id);

    if (!node) return;

    const info =
        TYPE_INFO[getType(node)] ||
        TYPE_INFO.unknown;

    let preview = "";

    if (
