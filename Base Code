        `;
    } else if (node.type === "folder") {
        preview = `
            <div class="preview-content">
                ${getChildren(node.id).length} item(s)
            </div>
        `;
    } else {
        preview = `
            <div style="text-align:center;color:var(--muted);margin-top:30px">
