function renderItems(items,f,selected){if(!items.length)return `<div style="padding:45px;text-align:center;opacity:.5">Nothing here.<br><span class="tiny">That may be because PearBrowser already stole all the interesting files.</span></div>`;if(f.view==='list')return `<div class="listhead"><span>Name</span><span>Kind</span><span>Size</span><span>Modified</span></div>`+items.map(o=>`<div class="row ${selected.has(o.id)?'sel':''}" data-id="${o.id}"><span>${icon(o)} ${esc(o.name)}</span><span>${esc(o.type)}</span><span>${sz(o.size||0)}</span><span>${new Date(o.modified).toLocaleString()}</span></div>`).join('');return `<div class="grid">`+items.map(o=>`<div class="card ${selected.has(o.id)?'sel':''}" data-id="${o.id}"><div class="ico">${icon(o)}</div><div class="fname" title="${esc(o.name)}">${esc(o.name)}</div></div>`).join('')+'</div>'}
