function escapeHTML(value) {
    return String(value)
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");
}

function toast(message) {
    const container = $("toasts");

    const el =
        document.createElement("div");

    el.className = "toast";
    el.textContent = message;

    container.appendChild(el);

    setTimeout(() => {
        el.style.opacity = "0";
        el.style.transform = "translateY(8px)";

        setTimeout(
            () => el.remove(),
            200
        );
    },1800);
}

function selectAll() {
