function renderBrowserPage(page,url){let parts=url.match(/^pear:\/\/([^?]+)(?:\?q=(.*))?$/i);let key=parts?`pear://${parts[1]}`:url;let site=sites[key]||sites['pear://search'];let q=parts?.[2]?decodeURIComponent(parts[2]):'';if(key==='pear://search'&&q){site={title:`Search: ${q}`,icon:'🔎',render:()=>`<div class="site"><div class="sitehero">🔎 PearSearch</div><p>Results for <b>${esc(q)}</b></p>${searchSite(q).map(r=>`<div class="result"><span class="fake-link" data-url="${r[0]}"><b>${esc(r[1])}</b></span><div class="tiny">${esc(r[0])}</div></div>`).join('')||'<div class="result">No results. The fake internet is shockingly small.</div>'}</div>`}}page.innerHTML=site.render();page.querySelectorAll('[data-url]').forEach(e=>e.onclick=()=>navigateBrowser(e.dataset.url));let search=page.querySelector('#homeSearch');if(search){search.onkeydown=e=>{if(e.key==='Enter')navigateBrowser(normalizeUrl(search.value))}}let sg=page.querySelector('#searchGo');if(sg){sg.onclick=()=>navigateBrowser(`pear://search?q=${encodeURIComponent(page.querySelector('#searchSite').value)}`)}let calc=page.querySelector('#calcgo');if(calc){calc.onclick=()=>{let s=page.querySelector('#calcresult');try{let expr=page.querySelector('#calc').value.replace(/[^0-9+\-*/().% ]/g,'');if(!expr)throw 0;s.textContent='Result: '+Function(`return (${expr})`)()}catch(e){s.textContent='Result: the calculator has entered witness protection.'}}}let gb=page.querySelector('#fakeGameBtn');if(gb){gb.onclick=()=>{let n=Math.floor(Math.random()*900)+100;page.querySelector('#gameMsg').textContent='Score: '+n+' — totally skill-based.'}}}
function navigateBrowser(url){let w=[...windows].reverse().find(x=>x.querySelector('.browser'));if(!w)return;let t=w.__browserState?.tabs?.[w.__browserState.active];if(!t){toast('Open PearBrowser from the dock');return}goBrowserState(w,url)}
function goBrowserState(w,url){let st=w.__browserState;if(!st)return;let t=st.tabs[st.active];t.history=t.history.slice(0,t.pos+1);t.history.push(url);t.pos++;t.url=url;renderBrowserWindow(w)}
function renderBrowserWindow(w){let st=w.__browserState;let t=st.tabs[st.active];let body=w.querySelector('.body');body.innerHTML=`<div class="browser"><div class="b-tabs">${st.tabs.map((x,i)=>`<div class="btab ${i===st.active?'active':''}" data-tab="${i}">${x.icon} <span class="ttext">${esc(x.title)}</span><span data-close="${i}">×</span></div>`).join('')}<div class="btab" id="newtab" style="min-width:42px;width:42px;justify-content:center">＋</div></div><div class="bbar"><button id="bback">←</button><button id="bfwd">→</button><button id="breload">↻</button><button id="bhome">⌂</button><input id="baddr" class="addr" value="${esc(t.url)}"><button id="bgo">Go</button></div><div class="bpage" id="bpage"></div></div>`;renderBrowserPage(body.querySelector('#bpage'),t.url);body.querySelectorAll('[data-tab]').forEach(e=>e.onclick=()=>{st.active=+e.dataset.tab;renderBrowserWindow(w)});body.querySelectorAll('[data-close]').forEach(e=>e.onclick=ev=>{ev.stopPropagation();let i=+e.dataset.close;if(st.tabs.length===1)return;st.tabs.splice(i,1);st.active=Math.max(0,Math.min(st.active,st.tabs.length-1));renderBrowserWindow(w)});body.querySelector('#newtab').onclick=()=>{st.tabs.splice(st.active+1,0,{url:'pear://home',title:'New Tab',icon:'🌐',history:['pear://home'],pos:0});st.active++;renderBrowserWindow(w)};body.querySelector('#bgo').onclick=()=>goBrowserState(w,normalizeUrl(body.querySelector('#baddr').value));body.querySelector('#baddr').onkeydown=e=>{if(e.key==='Enter')goBrowserState(w,normalizeUrl(e.target.value))};body.querySelector('#bback').onclick=()=>{let x=st.tabs[st.active];if(x.pos>0){x.pos--;x.url=x.history[x.pos];renderBrowserWindow(w)}};body.querySelector('#bfwd').onclick=()=>{let x=st.tabs[st.active];if(x.pos<x.history.length-1){x.pos++;x.url=x.history[x.pos];renderBrowserWindow(w)}};body.querySelector('#breload').onclick=()=>renderBrowserWindow(w);body.querySelector('#bhome').onclick=()=>goBrowserState(w,'pear://home')}
