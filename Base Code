function usbManager(){let w=win('USB Manager',580,460),b=w.querySelector('.body');function draw(){b.innerHTML=`<div class="info"><h2>Virtual USB Drives</h2><p>These drives are simulated and never touch physical USB hardware.</p><div id="ul"></div><button id="new">Create Virtual USB</button></div>`;let ul=b.querySelector('#ul');ul.innerHTML=S.usb.map(u=>`<div style="padding:10px;border-bottom:1px solid #0001;display:flex;gap:8px"><b>💾 ${esc(u.name)}</b><span style="flex:1">${S.connected.includes(u.id)?'Connected':'Ejected'}</span><button data-id="${u.id}">${S.connected.includes(u.id)?'Eject':'Connect'}</button></div>`).join('')||'<p>No virtual USB drives.</p>';ul.querySelectorAll('button').forEach(q=>q.onclick=()=>{let i=q.dataset.id;if(S.connected.includes(i))S.connected=S.connected.filter(x=>x!==i);else S.connected.push(i);save();draw();renderDesktop();toast(S.connected.includes(i)?'USB connected':'USB ejected')});b.querySelector('#new').onclick=()=>ask('Create Virtual USB','Drive name','PearStick',n=>{let uid=id(),root=id();let u={id:uid,name:n,root,fs:[{id:root,name:n,type:'folder',parent:null,size:0,content:'',created:new Date().toISOString(),modified:new Date().toISOString()}]};u.fs.push({id:id(),name:'USB README.txt',type:'txt',parent:root,size:41,content:'This USB drive is purely virtual.',created:now,modified:now});S.usb.push(u);S.connected.push(uid);save();draw();renderDesktop();toast('USB created and connected')})}draw()}
