function renderFinder(w,f){let b=w.querySelector('.body');let items=currentItems(f);let selected=new Set(f.sel);b.innerHTML=`<div class="finder"><aside class="side"><div class="label">Favorites</div>${[['Desktop','🖥️'],['Documents','📁'],['Downloads','⬇️'],['Pictures','🖼️'],['Applications','🧰'],['Archive','🗃️'],['Notes','📝'],['Writing','✍️'],['Projects','🧩'],['Media','🎬'],['Trash','🗑️']].map(x=>`<div class="sideitem ${(!f.usb&&f.id===rootId(x[0]))?'active':''}" data-nav="${esc(x[0])}">${x[1]} ${esc(x[0])}</div>`).join('')}<div class="label">USB</div>${S.connected.map(uid=>{let u=S.usb.find(x=>x.id===uid);return u?`<div class="sideitem ${f.usb===u.id?'active':''}" data-usb="${u.id}">💾 ${esc(u.name)}</div>`:''}).join('')}<div class="sideitem" id="usbman">🔌 USB Manager</div></aside><main class="main"><div class="tools"><button data-act="back">←</button><button data-act="forward">→</button><button data-act="up">↑</button><button data-act="newfolder">＋ Folder</button><button data-act="newfile">＋ File</button><button data-act="paste">Paste</button><button data-act="sort">Sort</button><button data-act="grid">▦</button><button data-act="list">☷</button><input class="search" placeholder="Search this Mac" value="${esc(f.q)}"></div><div class="path">${finderBreadcrumb(f)}</div><div class="area">${f.search&&f.q?`<div class="status" style="border:0;padding:0 0 8px">Search results for “${esc(f.q)}”</div>`:''}${renderItems(items,f,selected)}</div><div class="status">${items.length} item${items.length===1?'':'s'} · ${f.sel.length} selected · ${Object.keys(S.fs).length} total virtual entries</div></main></div>`;
