function currentItems(f){if(f.search&&f.q){let q=f.q.toLowerCase();let all=Object.values(S.fs).filter(o=>!trashed(o.id));if(f.usb){let u=S.usb.find(x=>x.id===f.usb);all=u?u.fs:[];all=all.filter(o=>o.id!==u?.root)}return all.filter(o=>`${o.name} ${o.content||''}`.toLowerCase().includes(q))}let arr=f.usb?(S.usb.find(u=>u.id===f.usb)?.fs||[]):Object.values(S.fs);return sortItems(arr.filter(o=>o.parent===f.id&&!trashed(o.id)))}
