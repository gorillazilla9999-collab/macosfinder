);

/* ---------- Window focus ---------- */

document.querySelectorAll(".window")
    .forEach(win => {
        win.addEventListener(
            "mousedown",
            () => focusWindow(win.id)
        );
    });

/* ---------- Finder traffic lights ---------- */

$("finderWindow")
    .querySelector(".close")
    .addEventListener("click",() => {
        closeWindow("finderWindow");
    });

$("finderWindow")
    .querySelector(".minimize")
    .addEventListener("click",() => {
        $("finderWindow").classList.add("hidden");
    });

$("finderWindow")
    .querySelector(".maximize")
    .addEventListener("click",() => {
        $("finderWindow").classList.toggle("maximized");
    });

/* ---------- Editor ---------- */

$("editorText").addEventListener(
    "input",
    editorChanged
);

$("editorName").addEventListener(
    "input",
    editorChanged
);

$("editorSave").addEventListener(
    "click",
    saveEditor
);

$("editorCancel").addEventListener(
    "click",
    closeEditor
);

$("editorClose").addEventListener(
    "click",
    closeEditor
);

$("editorMin").addEventListener(
    "click",
    () => $("editorWindow").classList.add("hidden")
);

$("editorMax").addEventListener(
    "click",
    () => $("editorWindow").classList.toggle("maximized")
);

/* ---------- Info ---------- */

$("infoClose").addEventListener(
    "click",
    () => closeWindow("infoWindow")
);

$("infoMax").addEventListener(
    "click",
    () => $("infoWindow").classList.toggle("maximized")
);

/* ---------- Settings ---------- */

$("settingsClose").addEventListener(
    "click",
    () => closeWindow("settingsWindow")
);

$("darkToggle").addEventListener(
    "change",
    event => {
        document.body.classList.toggle(
            "dark",
            event.target.checked
        );

        saveSettings();
    }
);

$("previewToggle").addEventListener(
    "change",
    event => {
        state.previewOpen =
            event.target.checked;

        render();
    }
);

$("exportBtn").addEventListener(
    "click",
    exportFilesystem
);

$("importBtn").addEventListener(
    "click",
    () => $("importFile").click()
);

$("importFile").addEventListener(
    "change",
    event => {
        const file = event.target.files[0];

        if (file) {
            importFilesystem(file);
        }

        event.target.value = "";
    }
);

$("resetBtn").addEventListener(
    "click",
    () => {
        if (
            confirm(
                "Reset Fake Finder?\n\nThis will erase the virtual filesystem stored in this browser."
            )
        ) {
            fs = createFilesystem();

            state.current = "desktop";
            state.selected.clear();
            state.history = ["desktop"];
            state.historyIndex = 0;
            state.clipboard = null;

            saveFS();
            render();

            toast("Filesystem reset");
        }
    }
);

/* =========================================================
   MENUBAR
   ========================================================= */

$("menuFinder").addEventListener(
    "click",
    focusFinder
);

$("menuFile").addEventListener(
    "click",
    showNewMenu
);

$("menuView").addEventListener(
    "click",
    () => {
        state.view =
            state.view === "icons"
                ? "list"
                : "icons";

        render();
    }
);

$("menuGo").addEventListener(
    "click",
    goParent
);

$("menuWindow").addEventListener(
    "click",
    focusFinder
);

$("menuHelp").addEventListener(
    "click",
    () => {
        alert(
            "Fake Finder\n\n" +
            "A browser-only simulated macOS file manager.\n\n" +
            "Keyboard shortcuts:\n" +
            "⌘/Ctrl+C  Copy\n" +
            "⌘/Ctrl+X  Cut\n" +
            "⌘/Ctrl+V  Paste\n" +
            "⌘/Ctrl+A  Select All\n" +
            "⌘/Ctrl+F  Search\n" +
            "Enter     Open\n" +
            "F2        Rename\n" +
            "Delete    Trash"
        );
    }
);

/* =========================================================
   CLOCK
   ========================================================= */

function updateClock() {
    $("clock").textContent =
        new Date().toLocaleString(
            [],
            {
                weekday:"short",
                month:"short",
                day:"numeric",
                hour:"numeric",
                minute:"2-digit"
            }
        );
}

setInterval(updateClock,1000);
updateClock();

/* =========================================================
   INITIALIZATION
   ========================================================= */

function initialize() {
    loadFS();
    loadSettings();
    loadWallpaper();

    state.current = "desktop";
    state.history = ["desktop"];
    state.historyIndex = 0;

    $("previewToggle").checked =
        state.previewOpen;

    render();

    /* Keep preview setting synchronized. */
    $("previewToggle").checked =
        state.previewOpen;

    /* Ensure Finder starts visible. */
    openWindow("finderWindow");
}

initialize();

</script>
</body>
</html>
