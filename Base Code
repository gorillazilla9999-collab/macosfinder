function updateFinderSelection(w,f){let body=w.querySelector('.body');if(!body)return;let selected=new Set(f.sel);body.querySelectorAll('[data-id]').forEach(e=>e.classList.toggle('sel',selected.has(e.dataset.id)));let st=body.querySelector('.status:last-child');if(st){let items=currentItems(f);st.innerHTML=`${items.length} item${items.length===1?'':'s'} · ${f.sel.length} selected · ${Object.keys(S.fs).length} total virtual entries`}}
function selectItem(ev,f,id0,w){let items=currentItems(f),index=items.findIndex(x=>x.id===id0);if(index<0)return;if(ev.shiftKey&&f.anchor){let a=items.findIndex(x=>x.id===f.anchor);if(a<0)a=index;let lo=Math.min(a,index),hi=Math.max(a,index);f.sel=items.slice(lo,hi+1).map(x=>x.id)}else if(ev.metaKey||ev.ctrlKey){f.sel=f.sel.includes(id0)?f.sel.filter(x=>x!==id0):[...f.sel,id0]}else f.sel=[id0];f.anchor=id0;updateFinderSelection(w,f)}
