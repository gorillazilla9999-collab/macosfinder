function renderDesktop(){let d=document.getElementById('desktop');d.innerHTML='';let a=[[rootId('Desktop'),'🖥️'],[rootId('Documents'),'📁'],[rootId('Downloads'),'⬇️'],[rootId('Pictures'),'🖼️'],[rootId('Applications'),'🧰'],[rootId('Trash'),'🗑️']];S.connected.forEach(uid=>{let u=S.usb.find(x=>x.id===uid);if(u)a.push([u.root,'💾',u.id])});a.forEach((x,i)=>{let e=document.createElement('div');e.className='dicon';e.style.left=18+(i%2)*110+'px';e.style.top=18+Math.floor(i/2)*98+'px';let o=x[2]?S.usb.find(u=>u.id===x[2])?.fs.find(q=>q.id===x[0]):get(x[0]);e.innerHTML=`<div class="dimg">${x[1]}</div><div class="dname">${esc(o?.name||'Drive')}</div>`;let drag=null;e.ondblclick=()=>x[2]?finder(x[0],x[2]):finder(o?.name||'Desktop');e.onmousedown=ev=>{if(ev.button!==0)return;drag={sx:ev.clientX,sy:ev.clientY,ox:e.offsetLeft,oy:e.offsetTop};const mm=q=>{if(!drag)return;let dx=q.clientX-drag.sx,dy=q.clientY-drag.sy;if(Math.abs(dx)+Math.abs(dy)>5){e.style.left=Math.max(0,drag.ox+dx)+'px';e.style.top=Math.max(0,drag.oy+dy)+'px'}};const mu=()=>{drag=null;removeEventListener('mousemove',mm);removeEventListener('mouseup',mu)};addEventListener('mousemove',mm);addEventListener('mouseup',mu)};e.oncontextmenu=q=>{q.preventDefault();menu(q.clientX,q.clientY,o,{id:o?.id,sel:o?[o.id]:[]},null)};d.appendChild(e)});d.oncontextmenu=e=>{if(e.target===d){e.preventDefault();menu(e.clientX,e.clientY,null,{id:rootId('Desktop'),sel:[]},null)}}}
