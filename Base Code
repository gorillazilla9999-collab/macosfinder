function dummyTrash(){
    return node("trash");
}

/* =========================================================
   USB
========================================================= */

function renderUSBs(){

    const box=$("usbSidebar");
    box.innerHTML="";

    Object.values(usbDrives).forEach(usb=>{

        if(!usb.connected) return;

        const div=document.createElement("div");

        div.className="sideItem";

        div.innerHTML=`
            💾 ${escapeHTML(usb.name)}
            <span class="usbDot"></span>
        `;

        div.onclick=()=>{
            goTo(usb.root);
        };

        div.oncontextmenu=e=>{
            e.preventDefault();
            showUSBContext(e.clientX,e.clientY,usb.id);
        };

        box.appendChild(div);
    });
}

function createUSB(){

    const id=uid();

    const name="Pear USB "+(Object.keys(usbDrives).length+1);

    const root=uid();

    const usb={
        id,
        name,
        capacity:16,
        connected:true,
        root,
        nodes:{
            [root]:{
                id:root,
                name,
                type:"usb",
                parent:null,
                children:[]
            }
        }
    };

    usbDrives[id]=usb;

    save();

    toast("USB connected");

    goTo(root);
    render();
}

function ejectUSB(id){

    const usb=usbDrives[id];

    if(!usb) return;

    usb.connected=false;

    if(currentFolder===usb.root){
        goTo("desktop");
    }

    save();

    toast("USB ejected");
    render();
}

function showUSBContext(x,y,id){

    const menu=$("contextMenu");

    menu.innerHTML=`
        <div class="contextItem" onclick="goToUSB('${id}')">
            Open
        </div>
        <div class="contextItem" onclick="ejectUSB('${id}')">
            ⏏ Eject
        </div>
        <div class="contextItem" onclick="renameUSB('${id}')">
            Rename
        </div>
        <div class="contextItem" onclick="formatUSB('${id}')">
            Format USB
        </div>
    `;

    positionMenu(x,y);
}

function goToUSB(id){

    const usb=usbDrives[id];

    if(usb && usb.connected){
        hideContext();
        goTo(usb.root);
    }
}

function renameUSB(id){

    const usb=usbDrives[id];

    hideContext();

    showDialog(
        "Rename USB",
        "Choose a new name for this virtual drive.",
        usb.name,
        value=>{
            if(value){
                usb.name=value;
                usb.nodes[usb.root].name=value;
                save();
                render();
            }
        }
    );
}

function formatUSB(id){

    const usb=usbDrives[id];

    hideContext();

    if(!usb) return;

    showDialog(
        "Format USB?",
        "This will delete every file on the USB.",
        "",
        ()=>{
            usb.nodes={
                [usb.root]:{
                    id:usb.root,
                    name:usb.name,
                    type:"usb",
                    parent:null,
                    children:[]
                }
            };

            save();

            toast("USB formatted");
            render();
        },
        true
    );
}

/* =========================================================
   OPEN
========================================================= */

function openNode(id){

    const n=node(id);

    if(!n) return;

    if(n.type==="folder" || n.type==="usb"){
        goTo(id);
        return;
    }

    if(n.type==="text"){
        openEditor(id);
        return;
    }

    toast("Cannot open this file");
}

/* =========================================================
   CREATE
========================================================= */

function newFolder(){

    hideContext();

    showDialog(
        "New Folder",
        "Enter a name for the new folder.",
        "Untitled Folder",
        name=>{

            if(!name) return;

            const finalName=uniqueName(currentFolder,name);

            addNode(currentFolder,{
                name:finalName,
                type:"folder",
                children:[]
            });

            render();
        }
    );
}

function newTextFile(){

    hideContext();

    showDialog(
        "New Text File",
        "Enter a name for the new file.",
        "Untitled.txt",
        name=>{

            if(!name) return;

            if(!name.includes(".")){
                name+=".txt";
            }

            const finalName=uniqueName(currentFolder,name);

            addNode(currentFolder,{
                name:finalName,
                type:"text",
                content:"",
                children:[]
            });

            render();
        }
    );
}

/* =========================================================
   MOVE
========================================================= */

function moveNode(id,destination){

    const n=node(id);
    const dest=node(destination);

    if(!n || !dest) return;

    if(dest.type!=="folder" && dest.type!=="usb") return;

    if(n.parent===destination) return;

    let check=dest;

    while(check){

        if(check.id===id){
            toast("You can't move a folder into itself");
            return;
        }

        check=check.parent ? node(check.parent) : null;
    }

    const old=node(n.parent);

    if(old){
        old.children=old.children.filter(x=>x!==id);
    }

    if(n.parent!==destination){
        n.name=uniqueName(destination,n.name);
    }

    n.parent=destination;

    if(!dest.children) dest.children=[];

    dest.children.push(id);

    save();

    toast("Moved "+n.name);
    render();
}

/* =========================================================
   COPY / PASTE
========================================================= */

function copySelected(){

    if(!selected){
        toast("Nothing selected");
        return;
    }

    const n=node(selected);

    if(!n) return;

    clipboard={
        id:n.id,
        mode:"copy"
    };

    toast("Copied "+n.name);

    hideContext();
}

function cutSelected(){

    if(!selected){
        toast("Nothing selected");
        return;
    }

    const n=node(selected);

    if(!n) return;

    clipboard={
        id:n.id,
        mode:"cut"
    };

    toast("Cut "+n.name);

    hideContext();
}

function paste(){

    if(!clipboard){
        toast("Nothing to paste");
        return;
    }

    const source=node(clipboard.id);

    if(!source){
        toast("File no longer exists");
        clipboard=null;
        return;
    }

    if(clipboard.mode==="cut"){

        moveNode(source.id,currentFolder);

        clipboard=null;

        return;
    }

    cloneNode(source.id,currentFolder);

    toast("Pasted "+source.name);

    render();
}

function cloneNode(id,destination){

    const source=node(id);

    if(!source) return;

    const copy={
        name:uniqueName(destination,source.name),
        type:source.type,
        content:source.content || "",
        children:[]
    };

    const newId=addNode(destination,copy);

    if(source.children){

        source.children.forEach(child=>{
            cloneNode(child,newId);
        });

    }

    return newId;
}

/* =========================================================
   DELETE / TRASH
========================================================= */

function deleteSelected(){

    if(!selected){
        toast("Nothing selected");
        return;
    }

    const n=node(selected);

    if(!n || n.id==="trash"){
        return;
    }

    if(n.parent==="trash"){
        permanentlyDelete(n.id);
    }else{
        moveNode(n.id,"trash");
        toast("Moved to Trash");
    }

    selected=null;
    hideContext();
    render();
}

function permanentlyDelete(id){

    const n=node(id);

    if(!n) return;

    if(n.children){
        [...n.children].forEach(child=>{
            permanentlyDelete(child);
        });
    }

    removeNode(id);
}

functionemptyTrash(){

    const trash=node("trash");

    [...trash.children].forEach(id=>{
        permanentlyDelete(id);
    });

    toast("Trash emptied");
    render();
}

/* =========================================================
   EDITOR
========================================================= */

function openEditor(id){

    const n=node(id);

    if(!n || n.type!=="text") return;

    editorFile=id;

    $("editorTitle").textContent=n.name;
    $("editorText").value=n.content || "";
    $("editorStatus").textContent="Saved";

    $("editor").classList.remove("hidden");

    bringToFront("editor");
}

function editorChanged(){

    $("editorStatus").textContent="Saving...";

    clearTimeout(editorTimer);

    editorTimer=setTimeout(()=>{

        const n=node(editorFile);

        if(n){
            n.content=$("editorText").value;
            n.modified=Date.now();

            save();

            $("editorStatus").textContent="Saved";
        }

    },300);
}

function closeEditor(){

    $("editor").classList.add("hidden");
    editorFile=null;
}

/* =========================================================
   SEARCH
========================================================= */

function searchFiles(value){

    value=value.trim().toLowerCase();

    if(!value){
        renderContent();
        return;
    }

    const content=$("content");

    let results=[];

    Object.values(fs.nodes).forEach(n=>{

        if(
            n.id!=="desktop" &&
            n.id!=="documents" &&
            n.id!=="downloads" &&
            n.id!=="applications" &&
            n.id!=="trash" &&
            n.name.toLowerCase().includes(value)
        ){
            results.push(n);
        }
    });

    Object.values(usbDrives).forEach(usb=>{

        if(!usb.connected) return;

        Object.values(usb.nodes).forEach(n=>{
            if(
                n.id!==usb.root &&
                n.name.toLowerCase().includes(value)
            ){
                results.push(n);
            }
        });

    });

    if(!results.length){
        content.innerHTML='<div class="empty">No results found</div>';
        return;
    }

    content.innerHTML='<div class="grid"></div>';

    const grid=content.querySelector(".grid");

    results.forEach(n=>{
        grid.appendChild(makeFileElement(n));
    });
}

/* =========================================================
   CONTEXT MENU
========================================================= */

function showContextMenu(x,y,id){

    selected=id;

    const n=node(id);

    const menu=$("contextMenu");

    menu.innerHTML=`
        <div class="contextItem" onclick="openNode('${id}')">Open</div>
        <div class="contextItem" onclick="copySelected()">Copy</div>
        <div class="contextItem" onclick="cutSelected()">Cut</div>
        <div class="contextItem" onclick="paste()">Paste</div>
        <div class="contextSep"></div>
        <div class="contextItem" onclick="renameNode('${id}')">Rename</div>
        <div class="contextItem" onclick="deleteSelected()">Move to Trash</div>
        <div class="contextSep"></div>
        <div class="contextItem" onclick="showInfo('${id}')">Get Info</div>
    `;

    positionMenu(x,y);
}

function positionMenu(x,y){

    const menu=$("contextMenu");

    menu.classList.remove("hidden");

    let px=x;
    let py=y;

    if(px+200>innerWidth) px=innerWidth-210;
    if(py+230>innerHeight) py=innerHeight-240;

    menu.style.left=px+"px";
    menu.style.top=py+"px";
}

function hideContext(){
    $("contextMenu").classList.add("hidden");
}

document.addEventListener("click",e=>{

    if(
        !e.target.closest("#contextMenu") &&
        !e.target.closest(".file")
    ){
        hideContext();
    }

});

/* =========================================================
   RENAME
========================================================= */

function renameNode(id){

    hideContext();

    const n=node(id);

    if(!n) return;

    showDialog(
        "Rename",
        "Enter a new name.",
        n.name,
        value=>{

            if(!value) return;

            n.name=uniqueName(n.parent,value);

            n.modified=Date.now();

            save();

            render();
        }
    );
}

/* =========================================================
   INFO
========================================================= */

function showInfo(id){

    hideContext();

    const n=node(id);

    if(!n) return;

    let extra="";

    if(n.type==="text"){
        extra=`Size: ${(n.content||"").length} characters`;
    }else if(n.children){
        extra=`Items: ${n.children.length}`;
    }

    alert(
        "Name: "+n.name+
        "\nType: "+n.type+
        "\n\n"+extra
    );
}

/* =========================================================
   DIALOG
========================================================= */

function showDialog(title,message,value,callback,danger=false){

    $("dialogTitle").textContent=title;
    $("dialogMessage").textContent=message;
    $("dialogInput").value=value || "";

    $("dialog").classList.remove("hidden");

    dialogCallback={
        callback,
        danger
    };

    setTimeout(()=>{
        $("dialogInput").focus();
        $("dialogInput").select();
    },20);
}

function dialogOK(){

    const value=$("dialogInput").value;

    const cb=dialogCallback;

    $("dialog").classList.add("hidden");
    dialogCallback=null;

    if(cb && cb.callback){
        cb.callback(value);
    }
}

function dialogCancel(){

    $("dialog").classList.add("hidden");
    dialogCallback=null;
}

$("dialogInput").addEventListener("keydown",e=>{

    if(e.key==="Enter"){
        dialogOK();
    }

    if(e.key==="Escape"){
        dialogCancel();
    }

});

/* =========================================================
   FINDER CONTROLS
========================================================= */

function closeFinder(){
    $("finder").classList.add("hidden");
}

function minimizeFinder(){
    $("finder").classList.add("hidden");
}

function hideWindow(id){
    $(id).classList.add("hidden");
}

function showFinder(){

    $("finder").classList.remove("hidden");

    bringToFront("finder");
}

function bringToFront(id){

    document.querySelectorAll(".window").forEach(w=>{
        w.style.zIndex=1000;
    });

    $(id).style.zIndex=2000;
}

function maximize(id){

    const w=$(id);

    w.classList.toggle("maximized");
}

function finderMenu(){

    showFinder();
}

function viewMenu(){

    toast("Finder view options coming soon");
}

function usbMenu(){

    createUSB();
}

/* =========================================================
   DRAG WINDOWS
========================================================= */

let dragWindow=null;
let dragOffsetX=0;
let dragOffsetY=0;

function startDrag(e,id){

    if(e.target.closest(".traffic")) return;

    const w=$(id);

    if(w.classList.contains("maximized")) return;

    dragWindow=w;

    const rect=w.getBoundingClientRect();

    dragOffsetX=e.clientX-rect.left;
    dragOffsetY=e.clientY-rect.top;

    bringToFront(id);
}

document.addEventListener("mousemove",e=>{

    if(!dragWindow) return;

    dragWindow.style.left=(e.clientX-dragOffsetX)+"px";
    dragWindow.style.top=(e.clientY-dragOffsetY)+"px";
});

document.addEventListener("mouseup",()=>{
    dragWindow=null;
});

/* =========================================================
   KEYBOARD SHORTCUTS
========================================================= */

document.addEventListener("keydown",e=>{

    if(e.metaKey || e.ctrlKey){

        if(e.key.toLowerCase()==="c"){
            e.preventDefault();
            copySelected();
        }

        if(e.key.toLowerCase()==="x"){
            e.preventDefault();
            cutSelected();
        }

        if(e.key.toLowerCase()==="v"){
            e.preventDefault();
            paste();
        }

    }

    if(e.key==="Backspace" && !e.target.matches("input,textarea")){
        deleteSelected();
    }

    if(e.key==="Escape"){
        hideContext();
    }
});

/* =========================================================
   CLOCK
========================================================= */

function updateClock(){

    const d=new Date();

    $("clock").textContent=
        d.toLocaleTimeString([],{
            hour:"numeric",
            minute:"2-digit"
        });
}

setInterval(updateClock,1000);

/* =========================================================
   TOAST
========================================================= */

let toastTimer;

function toast(message){

    const t=$("toast");

    t.textContent=message;
    t.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer=setTimeout(()=>{
        t.classList.remove("show");
    },1800);
}

/* =========================================================
   DESKTOP RIGHT CLICK
========================================================= */

$("desktop").addEventListener("contextmenu",e=>{

    if(
        e.target.closest(".window") ||
        e.target.closest(".desktopIcon") ||
        e.target.closest("#menubar")
    ){
        return;
    }

    e.preventDefault();

    const menu=$("contextMenu");

    menu.innerHTML=`
        <div class="contextItem" onclick="newFolder()">New Folder</div>
        <div class="contextItem" onclick="newTextFile()">New Text File</div>
        <div class="contextSep"></div>
        <div class="contextItem" onclick="createUSB()">Plug In USB</div>
        <div class="contextItem" onclick="showFinder()">Open Finder</div>
    `;

    positionMenu(e.clientX,e.clientY);
});

/* =========================================================
   STARTUP
========================================================= */

function boot(){

    load();

    const status=$("bootStatus");

    setTimeout(()=>{
        status.textContent="Checking Pear hardware...";
    },700);

    setTimeout(()=>{
        status.textContent="Loading Finder...";
    },1400);

    setTimeout(()=>{
        $("boot").style.opacity="0";

        setTimeout(()=>{

            $("boot").remove();
            $("desktop").classList.remove("hidden");

            goTo("desktop");

            setTimeout(()=>{
                showFinder();
            },250);

        },800);

    },2100);
}

boot();

/* =========================================================
   OPTIONAL: CREATE USB WITH BUTTON
   Shortcut:
   Shift + U
========================================================= */

document.addEventListener("keydown",e=>{

    if(e.shiftKey && e.key.toLowerCase()==="u"){
        createUSB();
    }

});
