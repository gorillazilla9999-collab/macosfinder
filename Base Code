function finderAction(a,f,w){if(a==='back'){let x=f.history.pop();if(x){f.future.push(f.id);f.id=x;renderFinder(w,f)}return}if(a==='forward'){let x=f.future.pop();if(x){f.history.push(f.id);f.id=x;renderFinder(w,f)}return}if(a==='up'){let o=f.usb?S.usb.find(u=>u.id===f.usb)?.fs.find(x=>x.id===f.id):get(f.id);if(o?.parent)navTo(f,o.parent,w);return}if(a==='newfolder'){newItem(f,w,true);return}if(a==='newfile'){newItem(f,w,false);return}if(a==='paste'){paste(f,w);return}if(a==='sort'){sorter(f,w);return}if(a==='grid'||a==='list'){f.view=a;renderFinder(w,f)}}
