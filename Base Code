function trashItems(f,w){let ids=f.sel.length?f.sel:[];ids.forEach(x=>{if(f.usb)return;let o=get(x);if(o&&o.id!==rootId('Trash')&&!trashed(x)){S.trash.push(x);o.parent=rootId('Trash')}});save();f.sel=[];renderFinder(w,f);toast('Moved to Trash')}
