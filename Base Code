function newItem(f,w,isFolder){ask(isFolder?'New Folder':'New File','Name',isFolder?'Untitled Folder':'Untitled.txt',name=>{let o=make(name,isFolder?'folder':extType(name),f.id,isFolder?'':`New virtual ${name} file.\n`);if(f.usb){let u=S.usb.find(x=>x.id===f.usb);u.fs.push(o);o.parent=f.id}else S.fs[o.id]=o;save();toast(isFolder?'Folder created':'File created');renderFinder(w,f)})}
