/* =========================================================
   KEYBOARD SHORTCUTS
   ========================================================= */

document.addEventListener("keydown",event => {
    const active =
        document.activeElement;

    const typing =
        active &&
        (
            active.tagName === "INPUT" ||
            active.tagName === "TEXTAREA"
        );

    if (event.key === "Escape") {
        hideContextMenu();
    }

    if (
        event.key === "F2" &&
        !typing &&
        state.selected.size === 1
    ) {
        event.preventDefault();

        renameNode(
            [...state.selected][0]
        );
    }

    if (
        event.key === "Enter" &&
        !typing &&
        state.selected.size === 1
    ) {
        event.preventDefault();

        openNode(
            [...state.selected][0]
        );
    }

    if (
        event.key === "Backspace" ||
        event.key === "Delete"
    ) {
        if (!typing && state.selected.size) {
            event.preventDefault();

            [...state.selected].forEach(moveToTrash);
        }
    }

    if (
        (event.metaKey || event.ctrlKey) &&
        event.key.toLowerCase() === "a" &&
        !typing
    ) {
        event.preventDefault();
        selectAll();
    }

    if (
        (event.metaKey || event.ctrlKey) &&
        event.key.toLowerCase() === "c" &&
        !typing
    ) {
        event.preventDefault();
        copySelection(false);
    }

    if (
        (event.metaKey || event.ctrlKey) &&
        event.key.toLowerCase() === "x" &&
        !typing
    ) {
        event.preventDefault();
        copySelection(true);
    }

    if (
        (event.metaKey || event.ctrlKey) &&
        event.key.toLowerCase() === "v" &&
        !typing
    ) {
        event.preventDefault();
        pasteClipboard();
    }

    if (
        (event.metaKey || event.ctrlKey) &&
        event.key.toLowerCase() === "f"
    ) {
        event.preventDefault();
        $("searchBox").focus();
        $("searchBox").select();
    }

    if (
        event.key === "ArrowDown" &&
        !typing
    ) {
        navigateSelection(1);
    }

    if (
        event.key === "ArrowUp" &&
        !typing
    ) {
        navigateSelection(-1);
    }
});

function navigateSelection(direction) {
    const nodes =
        state.search
            ? searchFilesystem(state.search)
            : sortedNodes(getChildren(state.current));

    if (!nodes.length) return;

    const current =
        [...state.selected][0];

    let index =
        nodes.findIndex(n => n.id === current);

    if (index < 0) {
        index =
            direction > 0 ? -1 : nodes.length;
    }

    index += direction;

    index =
        Math.max(
            0,
            Math.min(nodes.length - 1,index)
        );

    state.selected.clear();
    state.selected.add(nodes[index].id);

    renderContent();
    renderPreview();
    renderStatus();
}

