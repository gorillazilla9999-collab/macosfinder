</style></head><body><div id="os" class="os dark"><div id="wall" class="wall"></div><div id="boot" class="boot"><div class="pear"></div><h1>PearOS</h1><div id="bootmsg" class="bootmsg">Starting PearOS...</div><div class="loader"><i></i></div></div><div class="top"><div class="mi" id="pearMenu">🍐</div><div class="mi" id="finderMenu">Finder</div><div class="mi" id="browserMenu">PearBrowser</div><div class="mi" id="fileMenu">File</div><div class="mi" id="viewMenu">View</div><div class="mi" id="goMenu">Go</div><div class="spacer"></div><div id="clock"></div></div><div id="desktop" class="desktop"></div><div class="dock"><button id="finderDock">🗂️</button><button id="browserDock">🌐</button><button id="settingsDock">⚙️</button><button id="trashDock">🗑️</button><button id="aboutDock">🍐</button></div><div id="toasts" class="toastbox"></div></div><input id="importer" class="hidden" type="file" accept="application/json,.json">
<script>
const STORE='pearos_mega_v3';
let S=null,windows=[],z=30,clip={ids:[],cut:false};
const W=["radial-gradient(circle at 20% 20%,#5c82ff55,transparent 30%),linear-gradient(135deg,#0b1020,#243c6d 55%,#101827)","linear-gradient(135deg,#061b35,#126e9e 48%,#09111e)","radial-gradient(circle at 70% 25%,#a45cff88,transparent 28%),radial-gradient(circle at 20% 80%,#3a79ff66,transparent 30%),linear-gradient(135deg,#130d27,#070812)","linear-gradient(120deg,#17252a,#4d6b65 50%,#101a18)","radial-gradient(circle at 35% 30%,#ffca7a55,transparent 20%),linear-gradient(160deg,#18233b,#6c4b64 50%,#151421)"];
const ICON={folder:'📁',txt:'📄',md:'📝',html:'🌐',js:'🟨',css:'🎨',json:'🧩',png:'🖼️',jpg:'🖼️',gif:'🖼️',svg:'🖼️',webp:'🖼️',app:'🧰',zip:'🗜️',doc:'📘',docx:'📘',pdf:'📕',csv:'📊',xml:'🧬',log:'📜',ini:'⚙️',conf:'⚙️',sh:'⌨️',py:'🐍',java:'☕',c:'🔧',cpp:'🔧',h:'🧱',ts:'🟦',tsx:'⚛️',jsx:'⚛️',sql:'🗄️',yaml:'🧾',yml:'🧾',toml:'🧾',scratch:'🐱',mp3:'🎵',wav:'🔊',mp4:'🎬',mov:'🎬',wav:'🔊',ttf:'🔤',unknown:'📄'};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let seq=0;const id=()=>`v${(++seq).toString(36)}${Date.now().toString(36)}`;
const now='2026-10-01T12:00:00.000Z';
function make(name,type,parent,content=''){return{id:id(),name,type,parent,content,size:Math.max(1,content.length),created:now,modified:now}};
function folder(name,parent){return make(name,'folder',parent,'')}
function extType(name){let x=(name.split('.').pop()||'').toLowerCase();return ICON[x]?x:'unknown'}
function slug(s){return s.replace(/[^A-Za-z0-9]+/g,' ').trim()}
function defaultFS(){
  seq=0;let fs={};const put=o=>fs[o.id]=o;const roots={};
  const rootNames=['Desktop','Documents','Downloads','Pictures','Applications','Archive','Notes','Writing','Projects','Media','School'];
  rootNames.forEach(n=>{let o=folder(n,null);put(o);roots[n]=o.id});
  const folderMap={};Object.keys(roots).forEach(k=>folderMap[k]=roots[k]);
  // Mostly-flat folder layout: 1,100 base folders, with only 2% of those
  // containing one extra nested folder. This keeps Finder feeling believable.
  const themes={
    School:['Year 9','Science','Maths','English','History','Geography','Design','Digital Tech','Robotics','Study','Assignments'],
    Projects:['Game Dev','Coding','Animation','Web Projects','Scratch','Robotics','UI','Boss Fights','Level Design','Prototypes','Playtests'],
    Writing:['Stories','Characters','Worldbuilding','Scripts','Comics','Dialogue','Plots','Lore','Drafts','Research','Ideas'],
    Media:['Photos','Screenshots','Recordings','Music','Video','Wallpapers','Icons','Sprites','Textures','Reference'],
    Archive:['Old Projects','Backups','Snapshots','Exports','Recovered','Indexes','Retired Builds','Old Assets','Back Copies','History','Archives'],
    Notes:['Daily Notes','Idea Dumps','Checklists','Lists','Quick Notes','Plans','Reminders','Game Ideas','Coding Notes','Animation Notes','Random'],
    Documents:['School Docs','Projects','Plans','Reports','Manuals','References','Receipts','Schedules','Letters','Forms','Notes'],
    Downloads:['Installers','ZIP Files','PDFs','Assets','School Downloads','Game Files','Templates','Old Downloads','Shared Files','Packages','Misc'],
    Pictures:['Wallpapers','Screenshots','Doodles','Game Art','Animation Frames','Photos','Icons','Memes','Textures','Concepts','Exports'],
    Applications:['Creative Apps','Coding Apps','Games','Utilities','Browsers','Audio Tools','Video Tools','School Tools','System Tools','Test Apps','Old Apps'],
    Desktop:['Projects','Shortcuts','Screenshots','Quick Stuff','To Sort','Temporary','Game Builds','School','Art','Notes','Misc']
  };
  const qualifiers=['Alpha','Beta','Final','Draft','Reference','Ideas','Working','Backup','Archive','Export'];
  const formats=['Set','Collection','Pack','Folder','Bundle','Batch','Library','Kit','Workspace','Project'];
  const baseFolders=[];
  for(const root of rootNames){
    const list=themes[root]||['General'];
    for(let i=1;i<=100;i++){
      const topic=list[(i-1)%list.length];
      const qual=qualifiers[Math.floor((i-1)/list.length)%qualifiers.length];
      const fmt=formats[(i-1)%formats.length];
      const name=`${topic} ${qual} ${fmt} ${String(i).padStart(3,'0')}`;
      const fid=addFolder(roots[root],name);
      baseFolders.push({id:fid,root,number:i});
    }
  }
  // Exactly 2% of the 1,100 base folders get one child folder: 22 nested folders.
  const nestedIndexes=new Set();
  for(let i=49;i<baseFolders.length;i+=50) nestedIndexes.add(i);
  for(const index of nestedIndexes){
    const b=baseFolders[index];
    addFolder(b.id,`Subfolder - ${b.root} ${String(b.number).padStart(3,'0')}`);
  }
  // Root aliases/directories used by the OS.
  const named=['Documents','Downloads','Pictures','Applications','Trash','Desktop'];
  for(const n of named) folderMap[n]=roots[n];
  // deterministic file generation: exactly 3200 files, varied extensions, purposeful naming.
  const categories=[
    {root:'School',area:'Science',prefix:'Science Lab',ext:['pdf','docx','csv','txt','md','png'],topic:['Motion','Energy','Cells','Ecology','Chemistry','Earth Systems','Forces','Light']},
    {root:'School',area:'Mathematics',prefix:'Math Workbook',ext:['pdf','docx','csv','txt'],topic:['Algebra','Geometry','Statistics','Graphs','Probability','Measurement','Patterns','Revision']},
    {root:'School',area:'English',prefix:'English Reading',ext:['pdf','docx','txt','md'],topic:['Character','Theme','Structure','Vocabulary','Analysis','Draft','Planning','Reflection']},
    {root:'Projects',area:'Game Development',prefix:'Game Build',ext:['js','json','png','svg','txt','md','wav','mp3','csv'],topic:['Player','Enemy','Boss','Level','UI','Inventory','Dialogue','Save System','Particles','Camera']},
    {root:'Projects',area:'Coding',prefix:'Code Lab',ext:['js','ts','py','html','css','json','xml','yaml','yml','toml','sql','log'],topic:['Input','Renderer','Parser','Storage','Network Mock','Menu','Search','Settings','Debug','Utility']},
    {root:'Projects',area:'Animation',prefix:'Animation Shot',ext:['svg','png','jpg','gif','mp4','mov','wav','txt','md'],topic:['Intro','Walk Cycle','Run Cycle','Dino','Pizza','Frog','Cat','Robot','Background','Credits']},
    {root:'Writing',area:'Stories',prefix:'Story Draft',ext:['md','txt','docx','pdf'],topic:['Opening','Scene','Dialogue','Climax','Ending','Character Arc','World Detail','Revision']},
    {root:'Writing',area:'Worldbuilding',prefix:'World Note',ext:['md','txt','json','yaml','pdf'],topic:['City','Planet','Faction','Creature','Technology','History','Map','Rumor']},
    {root:'Media',area:'Pictures',prefix:'Art Asset',ext:['png','jpg','svg','webp'],topic:['Icon','Sprite','Wallpaper','Concept','Sketch','Background','Texture','Thumbnail']},
    {root:'Media',area:'Music',prefix:'Audio Asset',ext:['mp3','wav','txt'],topic:['Menu','Boss','Calm','Alert','Victory','Loop','Ambience','Jingle']},
    {root:'Media',area:'Video',prefix:'Video Clip',ext:['mp4','mov','txt'],topic:['Trailer','Test','Gameplay','Cutscene','Timelapse','Reference']},
    {root:'Archive',area:'Backups',prefix:'Backup Snapshot',ext:['zip','json','log','txt'],topic:['Project','Desktop','Documents','Settings','Assets','Save']},
    {root:'Notes',area:'Idea Dumps',prefix:'Idea Note',ext:['md','txt'],topic:['Game','Animation','Browser','Scratch','Robot','Puzzle','Boss','Random']},
  ];
  // Collect leaf folders and deliberately distribute files.
  const leaves=[];for(const o of Object.values(fs))if(o.type==='folder' && o.name!=='Trash' && o.name!=='Desktop')leaves.push(o.id);
  let fileCount=0;let cidx=0;
  while(fileCount<3200){let c=categories[cidx%categories.length];let parent=leaves[(fileCount*7+cidx*13)%leaves.length];let topic=c.topic[(fileCount+cidx)%c.topic.length];let ext=c.ext[(fileCount*3+cidx)%c.ext.length];let base=`${c.prefix} ${String((fileCount%80)+1).padStart(2,'0')} - ${topic}`;let name=`${base}.${ext}`;let content;
    if(['png','jpg','gif','svg','webp'].includes(ext)) content=`Fictional ${topic.toLowerCase()} image asset.\n\nPearOS preview placeholder.\nAsset group: ${c.area}.`;
    else if(['mp3','wav','mp4','mov'].includes(ext)) content=`Fictional media placeholder.\nTitle: ${base}\nPurpose: ${c.area} test asset.`;
    else if(ext==='json') content=JSON.stringify({project:c.area,name:base,version:1,notes:`Virtual ${topic.toLowerCase()} data file.`},null,2);
    else if(ext==='csv') content=`item,value,notes\n${topic},${fileCount+1},Virtual ${c.area} dataset\n`;
    else if(ext==='html') content=`<!doctype html><title>${esc(base)}</title><p>Fictional PearOS project page.</p>`;
    else if(ext==='js'||ext==='ts'||ext==='py'||ext==='sql'||ext==='sh'||ext==='c'||ext==='cpp'||ext==='h') content=`// PearOS virtual code file\n// Area: ${c.area}\n// Topic: ${topic}\n\nfunction demo(){ return "${topic}"; }\n`;
    else content=`${base}\n\nThis is a deliberately designed fictional file inside the PearOS virtual filesystem.\nArea: ${c.area}\nTopic: ${topic}\nIndex: ${fileCount+1}\n`;
    let f=make(name,ext,parent,content);put(f);fileCount++;cidx++;
  }
  // Essential hand-written files and one hidden secret.
  put(make('Welcome to PearOS.txt','txt',roots.Desktop,'Welcome to PearOS!\n\nThis whole computer is virtual. Explore Finder, try PearBrowser, and search around.'));
  put(make('PearOS Manual.md','md',roots.Documents,'PearOS is a fictional browser operating system. It never touches your real files.\n\nTip: try searching for "secret" in Finder.'));
  const hiddenParent=leaves[leaves.length-1];
  put(make('archive_index.txt','txt',hiddenParent,'There is an old document somewhere in the archive. The index does not list its exact location.'));
  put(make('something_missing.md','md',hiddenParent,'The folder feels incomplete. One document was intentionally left out of the index.'));
  put(make('secret.doc','doc',hiddenParent,'PEAROS ARCHIVE NOTE\n\nYou found it.\n\nNothing dangerous is hidden here—just a tiny Easter egg.\n\nMessage: curiosity is a feature.'));
  return {fs,roots};
}
function findFolderByName(fs,name,idHint){if(idHint&&fs[idHint])return idHint;let x=Object.values(fs).find(o=>o.type==='folder'&&o.name===name);return x?x.id:null}
function initial(){let d=defaultFS();return{fs:d.fs,roots:d.roots,trash:[],usb:[],connected:[],settings:{theme:'dark',wall:0,view:'grid',sort:'name',asc:true}}}
function save(){try{localStorage.setItem(STORE,JSON.stringify(S))}catch(e){toast('Storage is full — export a backup and reset if needed.')}}
function load(){try{S=JSON.parse(localStorage.getItem(STORE))}catch(e){S=null}if(!S||!S.fs||!S.roots||!Object.values(S.fs).some(x=>x.name==='secret.doc')||Object.keys(S.fs).length<4000){S=initial();save()}}
function get(x){return S.fs[x]}
function kids(p){return Object.values(S.fs).filter(x=>x.parent===p)}
function trashSet(){return new Set(S.trash||[])}
function trashed(x){return trashSet().has(x)}
function rootId(name){return S.roots[name]||Object.values(S.fs).find(o=>o.parent===null&&o.name===name)?.id}
function path(x){let a=[];while(x){let o=get(x);if(!o)break;a.unshift(o.name);x=o.parent}return a.join(' / ')}
function icon(x){return x.type==='folder'?ICON.folder:(ICON[x.type]||ICON.unknown)}
function sz(n){return n<1024?n+' B':n<1048576?(n/1024).toFixed(1)+' KB':(n/1048576).toFixed(1)+' MB'}
function theme(){document.getElementById('os').classList.toggle('dark',S.settings.theme==='dark');document.getElementById('wall').style.background=W[S.settings.wall%W.length]}
function toast(msg){let e=document.createElement('div');e.className='toast';e.textContent=msg;document.getElementById('toasts').appendChild(e);setTimeout(()=>e.remove(),2200)}
